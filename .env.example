# Copy to .env.local for local development. Never commit real values.
# Production and preview values live in Vercel project env vars.

# Formspree contact form (live form and a separate test form)
FORMSPREE_FORM_ID=
FORMSPREE_TEST_FORM_ID=

# Playwright: point tests at a deployed URL (for example a Vercel preview).
# Leave empty to build and serve the site locally.
PLAYWRIGHT_BASE_URL=

# Vercel Deployment Protection bypass, only needed if previews are protected.
VERCEL_AUTOMATION_BYPASS_SECRET=
