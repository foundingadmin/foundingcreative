# Copy to .env.local for local development. Never commit real values.
# Production and preview values live in Vercel project env vars.

# Formspree contact form (live form and a separate test form)
FORMSPREE_FORM_ID=
FORMSPREE_TEST_FORM_ID=

# GA4 measurement ID (G-XXXXXXXXXX, from GA Admin > Data streams). Only
# production builds load GA4, and only on foundingcreative.com after consent.
GA_MEASUREMENT_ID=

# Playwright: point tests at a deployed URL (for example a Vercel preview).
# Leave empty to build and serve the site locally.
PLAYWRIGHT_BASE_URL=

# Vercel Deployment Protection bypass, only needed if previews are protected.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Case study image pipeline (docs/case-study-sop.md). Local scripts only,
# never the Vercel build. The model is the Gemini image model's ID.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=
