---
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import logo from '../assets/brand/founding-wordmark-white.svg';
import { linkedInHref } from '../data/navigation';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Defaults to `title`. */
  ogTitle?: string;
  /** Defaults to `description`. */
  ogDescription?: string;
  /** An imported image (resized to a 1200px JPEG for sharing) or a URL. */
  ogImage?: ImageMetadata | string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  /** For articles: adds article:* Open Graph tags. */
  article?: { published: Date; modified?: Date; section?: string; tags?: string[] };
  /** Page-specific schema.org data, added after the site-wide Organization. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Keep the page out of search results (also excluded from the sitemap in astro.config.mjs). */
  noindex?: boolean;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage,
  ogImageAlt,
  ogType = 'website',
  article,
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Social platforms want a static JPEG or PNG, so animated or WebP images are
// flattened to a 1200px JPEG here.
let ogImageUrl: string | undefined;
let ogImageSize: { width: number; height: number } | undefined;
if (typeof ogImage === 'string') {
  ogImageUrl = new URL(ogImage, Astro.site).href;
} else if (ogImage) {
  const image = await getImage({ src: ogImage, width: 1200, format: 'jpg', quality: 82 });
  ogImageUrl = new URL(image.src, Astro.site).href;
  ogImageSize = { width: Number(image.attributes.width), height: Number(image.attributes.height) };
}

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${Astro.site}#organization`,
  name: 'Founding Creative',
  url: Astro.site?.href,
  logo: new URL(logo.src, Astro.site).href,
  sameAs: [linkedInHref],
};
const schema = [organization, ...(jsonLd ? [jsonLd].flat() : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="Founding Creative Field Notes" href="/feed/" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Founding Creative" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageSize && <meta property="og:image:width" content={String(ogImageSize.width)} />}
    {ogImageSize && <meta property="og:image:height" content={String(ogImageSize.height)} />}
    {ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
          {article.section && <meta property="article:section" content={article.section} />}
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />

    <script type="application/ld+json" set:html={JSON.stringify(schema.length === 1 ? schema[0] : schema)} />

    <meta name="generator" content={Astro.generator} />

    <!-- Manrope, self-hosted by Astro (see astro.config.mjs) -->
    <Font cssVariable="--font-manrope" preload />
    <!-- Gelica from the Founding Creative Adobe Fonts kit. Adobe's license
         requires serving it from Adobe; the kit only serves domains listed in
         its Adobe Fonts settings. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/ooi7rue.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
