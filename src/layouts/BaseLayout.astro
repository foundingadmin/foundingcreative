---
import { Font } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Defaults to `title`. */
  ogTitle?: string;
  /** Absolute URL or site-relative path. */
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const { title, description, ogTitle = title, ogImage, ogType = 'website' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Founding Creative" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    <meta name="generator" content={Astro.generator} />

    <!-- Manrope, self-hosted by Astro (see astro.config.mjs) -->
    <Font cssVariable="--font-manrope" preload />
    <!-- Gelica from the Founding Creative Adobe Fonts kit. Adobe's license
         requires serving it from Adobe; the kit only serves domains listed in
         its Adobe Fonts settings. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/ooi7rue.css" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
