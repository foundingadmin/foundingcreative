---
import { Font, getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO, { type Article } from '../components/SEO.astro';
import { pages, type PageSeo } from '../data/seo';
import { isAnimated, type LcpImage } from '../lib/images';
import '../styles/global.css';

interface Props {
  /** Search and share metadata. Static pages are looked up in
   * src/data/seo.ts by path; pass `seo` for collection pages (`entrySeo`)
   * or to fill in a value only known at build time, like a share image. */
  seo?: Partial<PageSeo>;
  /** For articles: adds article:* Open Graph tags. */
  article?: Article;
  /** Page-specific schema.org data, added after the site-wide Organization. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** The page's LCP image, preloaded as AVIF (WebP if animated). Pass the same widths and sizes
   * as the <Picture> that shows it (see src/lib/images.ts), or the browser
   * downloads it twice. */
  lcpImage?: LcpImage;
}

const { article, jsonLd, lcpImage } = Astro.props;

const seo = { ...pages[Astro.url.pathname], ...Astro.props.seo };
if (!seo.title || !seo.description) {
  throw new Error(`${Astro.url.pathname} has no title or description. Add it to src/data/seo.ts.`);
}

const lcpFormat = lcpImage && isAnimated(lcpImage.src) ? 'webp' : 'avif';
const lcpPreload = lcpImage && (await getImage({ ...lcpImage, format: lcpFormat }));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Marks that scripts run, so scroll-reveal content only starts hidden when it can be revealed -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO seo={seo as PageSeo} article={article} jsonLd={jsonLd} />
    <link rel="alternate" type="application/rss+xml" title="Founding Creative Field Notes" href="/feed/" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {
      lcpPreload && (
        <link
          rel="preload"
          as="image"
          type={`image/${lcpFormat}`}
          imagesrcset={lcpPreload.srcSet.attribute}
          imagesizes={lcpImage?.sizes}
          fetchpriority="high"
        />
      )
    }

    <!-- Manrope, self-hosted by Astro (see astro.config.mjs). Only the latin
         subset is preloaded; latin-ext loads if a page needs it. -->
    <Font cssVariable="--font-manrope" preload={[{ subset: 'latin' }]} />
    <Font cssVariable="--font-ubuntu-mono" />
    <!-- Gelica from the Founding Creative Adobe Fonts kit. Adobe's license
         requires serving it from Adobe (the kit and its p.typekit.net
         tracking import stay as Adobe ships them); the kit only serves
         domains listed in its Adobe Fonts settings. It loads without blocking
         the first paint, and headings show in the metric-matched fallback
         (global.css) until it arrives. -->
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="preload" as="style" href="https://use.typekit.net/ooi7rue.css" />
    <link rel="stylesheet" href="https://use.typekit.net/ooi7rue.css" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://use.typekit.net/ooi7rue.css" /></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {
      Astro.slots.has('page-end') ? (
        <div class="page-end">
          <slot name="page-end" />
          <Footer />
        </div>
      ) : (
        <Footer />
      )
    }
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
