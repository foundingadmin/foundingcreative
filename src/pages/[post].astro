---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import PostToc from '../components/PostToc.astro';
import FieldNotes from '../components/FieldNotes.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import { getPosts, postUrl, formatDate, isoDate, type Post } from '../lib/content';

// Every Field Notes post renders through this one template, at the site root
// like the WordPress permalinks. The layout follows the live posts: a dark
// "aurora" band, a white page whose curved edge rises into it, and the cover
// card lifted over that curve. The card is the same size for every post, so
// headers line up from one post to the next whatever the title's length.
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { post: post.id }, props: { post, posts } }));
}

interface Props {
  post: Post;
  posts: Post[];
}

const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const { data } = post;

// Internal links help readers and search engines: same-category posts first.
const related = posts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    const shared = (p: Post) => p.data.categories.filter((c) => data.categories.includes(c)).length;
    return shared(b) - shared(a);
  })
  .slice(0, 5);

const url = new URL(postUrl(post), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    dateModified: data.updated.toISOString(),
    author: { '@type': 'Person', name: data.author },
    publisher: { '@id': `${Astro.site}#organization` },
    mainEntityOfPage: url,
    articleSection: data.categories,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Field Notes', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogImage={data.cover}
  ogImageAlt={data.coverAlt}
  ogType="article"
  article={{ published: data.date, modified: data.updated, section: data.categories[0], tags: data.categories }}
  jsonLd={jsonLd}
>
  <article class="post">
    <!-- The aurora band: decoration only, the card below rises into it -->
    <div class="post-aurora under-header">
      <HeroBackdrop variant="aurora" />
    </div>

    <div class="post-page curve-top curve-bottom">
      <header>
        <div class="container">
          <div class="post-card" data-intro>
            <Image
              class="post-card__image"
              src={data.cover}
              alt={data.coverAlt}
              widths={[640, 1280, 1920]}
              sizes="(max-width: 1200px) 100vw, 1140px"
              loading="eager"
              fetchpriority="high"
            />
            <nav aria-label="Breadcrumb" class="post-card__kicker">
              <a href="/blog/">Field Notes</a>
            </nav>
            <h1 class="post-card__title">{data.title}</h1>
            <p class="post-card__excerpt">{data.excerpt}</p>
            <p class="post-card__meta">
              <span class="post-card__category">{data.categories.join(', ')}</span>
              <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>
              <span class="post-card__author">By {data.author}</span>
            </p>
          </div>
        </div>
      </header>

      <div class="post-body">
        <div class="container post-body__grid">
          <PostToc headings={headings} />
          <Prose variant="article"><Content /></Prose>
        </div>
      </div>
    </div>
  </article>

  <div class="post-more">
    <FieldNotes posts={related} heading="More Field Notes" />
  </div>
</BaseLayout>

<style>
  /* How far the card rises into the aurora: 216px on the live posts, leaving
   * the curve's dip well under the card. */
  .post {
    --post-lift: calc(var(--curve-height) + 10rem);
  }

  /* ===== Aurora band ===== */
  .post-aurora {
    position: relative;
    height: calc(var(--header-height) + 8.75rem + var(--post-lift));
  }

  /* ===== White page and the cover card ===== */
  .post-page {
    --curve-color: var(--color-white);
    /* flow-root keeps the card's lift from dragging the curve up with it */
    display: flow-root;
    background-color: var(--color-white);
  }

  .post-card {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 47.75rem;
    margin-top: calc(-1 * var(--post-lift));
    padding: var(--space-2xl) var(--space-lg);
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--color-white);
    border-radius: var(--radius-card);
    background-color: var(--color-night);
    box-shadow: 0 0 48px 1px rgb(0 0 0 / 0.4);
    text-align: center;
  }

  .post-card__image {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The live veil: clear at the top, the page's night at the bottom */
  .post-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(rgb(0 4 7 / 0.35), var(--color-night));
  }

  .post-card__kicker {
    margin-bottom: var(--space-lg);
  }

  .post-card__kicker a {
    color: var(--color-white);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.4em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .post-card__kicker a:hover {
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }

  .post-card__title {
    max-width: 13em;
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-title);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-shadow: var(--text-glow);
    text-wrap: balance;
  }

  .post-card__excerpt {
    max-width: 30em;
    margin: 0 0 var(--space-lg);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-light);
    line-height: 1.6;
    text-wrap: balance;
  }

  .post-card__meta {
    display: grid;
    justify-items: center;
    gap: var(--space-3xs);
    margin: 0;
  }

  .post-card__category {
    color: rgb(211 211 211 / 0.77);
    font-weight: var(--font-weight-semibold);
  }

  .post-card__meta time {
    font-family: var(--font-display);
    font-size: var(--font-size-md);
  }

  .post-card__author {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  /* ===== Article ===== */
  .post-body {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  @media (min-width: 1200px) {
    .post-body__grid {
      display: grid;
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: start;
      gap: var(--space-xl);
    }
  }

  .post-more {
    padding-top: var(--curve-height);
  }

  @media (max-width: 700px) {
    .post-card {
      min-height: 36rem;
      padding: var(--space-xl) var(--space-md);
    }

    .post-card__kicker a {
      letter-spacing: 0.25em;
    }
  }
</style>
