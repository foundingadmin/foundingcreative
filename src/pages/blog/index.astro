---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Icon from '../../components/Icon.astro';
import wave from '../../assets/brand/wave-black.svg';
import { getPosts, postUrl, formatDate, isoDate } from '../../lib/content';

// The Field Notes index, as on the live site: the newest post featured in the
// aurora band the posts use, its cover hanging over the white page's curve,
// then every other post in two staggered columns. Cards stay in date order in
// the markup (left, right, left...), so reading and tab order match the eye.
const posts = await getPosts();
const [featured, ...rest] = posts;
const description =
  'Field Notes from Founding Creative: practical insights on brand strategy, website design, design systems, and creative leadership for marketers and founders.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Field Notes',
  description,
  url: new URL('/blog/', Astro.site).href,
  publisher: { '@id': `${Astro.site}#organization` },
  blogPost: posts.map((post) => ({
    '@type': 'BlogPosting',
    headline: post.data.title,
    url: new URL(postUrl(post), Astro.site).href,
    datePublished: post.data.date.toISOString(),
  })),
};
---

<BaseLayout
  title="Field Notes: Brand, Web & Design Insights | Founding Creative"
  description={description}
  ogTitle="Field Notes"
  ogImage={featured?.data.cover}
  ogImageAlt={featured?.data.coverAlt}
  jsonLd={jsonLd}
>
  <!-- The aurora band, with the newest post -->
  <header class="blog-head under-header" style={`--aurora-wave: url(${wave.src})`}>
    <div class="blog-head__wave" aria-hidden="true"></div>
    <div class="container blog-head__grid">
      <div class="blog-head__text" data-intro>
        <h1 class="blog-head__kicker">Field Notes</h1>
        {
          featured && (
            <article class="featured">
              <time class="featured__date" datetime={isoDate(featured.data.date)}>
                {formatDate(featured.data.date)}
              </time>
              <h2 class="featured__title">
                <a href={postUrl(featured)}>{featured.data.title}</a>
              </h2>
              <p class="featured__excerpt">{featured.data.excerpt}</p>
              <p class="featured__categories">{featured.data.categories.join(', ')}</p>
            </article>
          )
        }
      </div>
    </div>
    {
      featured && (
        <div class="featured__media">
          <Image
            src={featured.data.cover}
            alt={featured.data.coverAlt}
            widths={[640, 1280]}
            sizes="(max-width: 977px) 100vw, 42vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )
    }
  </header>

  <!-- Every other post, on the white page -->
  <section class="blog-page curve-top" aria-labelledby="archive-heading">
    <div class="container">
      <div class="archive">
        <div class="archive__head">
          <h2 id="archive-heading">More Field Notes</h2>
          <Icon name="arrow-right" size={32} class="archive__arrow" />
        </div>
        {rest.map((post) => <PostCard post={post} headingLevel={3} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Aurora band ===== */
  /* No stacking context here: the featured cover has to rise above the white
   * page's curve, which belongs to the next section. */
  .blog-head {
    position: relative;
    padding-block: calc(var(--header-height) + 6rem) var(--space-3xl);
    background: linear-gradient(
        -45deg,
        var(--color-black),
        var(--color-aurora-navy),
        var(--color-black),
        var(--color-aurora-indigo),
        var(--color-aurora-plum),
        var(--color-black),
        var(--color-aurora-ember),
        var(--color-black)
      )
      0% 50% / 400% 400%;
  }

  .blog-head__wave {
    position: absolute;
    inset: 0;
    background: var(--aurora-wave) center / cover no-repeat;
    opacity: 0.55;
  }

  .blog-head__grid {
    position: relative;
  }

  @media (prefers-reduced-motion: no-preference) {
    .blog-head {
      animation: blog-aurora 15s ease infinite;
    }
  }

  @keyframes blog-aurora {
    50% {
      background-position: 100% 50%;
    }
  }

  .blog-head__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .blog-head__text {
    padding-right: var(--space-xl);
  }

  /* The page's h1, set as the letter-spaced kicker the posts use */
  .blog-head__kicker {
    margin: 0 0 var(--space-lg);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.4em;
    line-height: var(--line-height-base);
    text-transform: uppercase;
  }

  .featured__date {
    display: block;
    margin-bottom: var(--space-md);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .featured__title {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    text-shadow: var(--text-glow);
    text-wrap: balance;
  }

  .featured__title a {
    color: var(--color-white);
    text-decoration: none;
  }

  .featured__title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.12em;
  }

  .featured__excerpt {
    margin-bottom: var(--space-md);
    font-size: var(--font-size-lg);
  }

  .featured__categories {
    margin: 0;
    color: rgb(211 211 211 / 0.77);
    font-weight: var(--font-weight-semibold);
  }

  /* The cover fills the band's right side and hangs over the white page's
   * curve, the way the post cover cards do */
  .featured__media {
    position: absolute;
    top: 0;
    right: 0;
    bottom: calc(-1 * var(--cover-lift));
    z-index: 2;
    width: 42%;
    overflow: hidden;
    border-bottom-left-radius: var(--radius-card);
    pointer-events: none;
  }

  .featured__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* A soft fade where the cover meets the text */
  .featured__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.55), transparent 35%);
  }

  /* ===== White page and the archive ===== */
  .blog-page {
    --curve-color: var(--color-white);
    padding-block: calc(var(--cover-lift) + var(--space-2xl)) var(--space-3xl);
    background-color: var(--color-white);
  }

  /* Two columns in date order; the right column drops so the heading can
   * sit at its head, and the cards fall into a staggered rhythm. */
  .archive {
    --stagger: 15rem;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-2xl) var(--space-2xl);
    padding-bottom: var(--stagger);
  }

  .archive > :global(.post-card:nth-of-type(even)) {
    translate: 0 var(--stagger);
  }

  .archive__head {
    position: absolute;
    top: 0;
    left: calc(50% + var(--space-2xl) / 2);
    right: 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-md);
    color: var(--color-night);
  }

  .archive__head h2 {
    max-width: 6em;
    margin: 0;
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-medium);
    line-height: 1;
  }

  .archive__head :global(.archive__arrow) {
    margin-top: 0.75rem;
    transform: rotate(90deg);
  }

  @media (prefers-reduced-motion: no-preference) {
    .archive__head :global(.archive__arrow) {
      animation: archive-nudge 2.4s var(--ease-out) infinite;
    }
  }

  @keyframes archive-nudge {
    50% {
      transform: rotate(90deg) translateX(6px);
    }
  }

  /* ===== Small screens: one column, cover above the text ===== */
  @media (max-width: 977px) {
    .blog-head {
      padding-bottom: 0;
    }

    .blog-head__grid {
      grid-template-columns: 1fr;
    }

    .blog-head__text {
      padding: 0 0 var(--space-xl);
    }

    .featured__media {
      position: relative;
      bottom: auto;
      width: auto;
      height: 18rem;
      margin-bottom: calc(-1 * var(--cover-lift));
      border-radius: 0 0 var(--radius-card) var(--radius-card);
    }

    .featured__media::after {
      background: linear-gradient(rgb(0 0 0 / 0.4), transparent 40%);
    }

    .blog-page {
      display: flow-root;
    }

    .archive {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
      padding-bottom: 0;
    }

    .archive > :global(.post-card:nth-of-type(even)) {
      translate: none;
    }

    .archive__head {
      position: static;
    }
  }
</style>
