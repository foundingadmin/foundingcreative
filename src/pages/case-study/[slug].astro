---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import OurWork from '../../components/OurWork.astro';
import SiteLaunchSection from '../../components/SiteLaunchSection.astro';
import Icon from '../../components/Icon.astro';
import { getCaseStudies, caseStudyUrl, type CaseStudy } from '../../lib/content';

export async function getStaticPaths() {
  const studies = await getCaseStudies();
  // Each study links on to the next one, wrapping around at the end.
  return studies.map((study, i) => ({
    params: { slug: study.id },
    props: { study, next: studies[(i + 1) % studies.length] },
  }));
}

interface Props {
  study: CaseStudy;
  next: CaseStudy;
}

const { study, next } = Astro.props;
const { Content } = await render(study);
const { data } = study;

// Each study's colors (from the live page) drive the hero gradient and the
// story's bands. Studies without a theme fall back to brand navy.
const fallbackTheme = { accent: '#001441', dark: '#000a20', light: '#e5fde9' };
const theme = data.theme ?? fallbackTheme;
const nextTheme = next.data.theme ?? fallbackTheme;

// Headings on the white and light bands use the accent, but a bright accent
// (Innovation Forum's orange) can fall under AA's 3:1 for large text on the
// light and neutral bands. Blend it toward the study's dark color only as far
// as needed.
const rgb = (hex: string) => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16));
const luminance = (c: number[]) =>
  c
    .map((v) => v / 255)
    .map((v) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4))
    .reduce((sum, v, i) => sum + v * [0.2126, 0.7152, 0.0722][i], 0);
const contrast = (a: number[], b: number[]) => {
  const [hi, lo] = [luminance(a), luminance(b)].sort((x, y) => y - x);
  return (hi + 0.05) / (lo + 0.05);
};
const headingInk = (() => {
  const [accent, dark, light] = [theme.accent, theme.dark, theme.light].map(rgb);
  for (let t = 0; t <= 1; t += 0.05) {
    const mix = accent.map((v, i) => Math.round(v + (dark[i] - v) * t));
    if ([light, [216, 216, 216], [255, 255, 255]].every((bg) => contrast(mix, bg) >= 3)) return `rgb(${mix.join(' ')})`;
  }
  return theme.dark;
})();

// The closing image card near the end of the story reuses the cover and
// logo, drawn by CSS (it is decorative), so pass them in as variables.
const closingCover = await getImage({ src: data.cover, width: 1600, format: 'webp' });
const closingLogo = data.logo ? await getImage({ src: data.logo }) : undefined;
const themeStyle = [
  `--case-accent: ${theme.accent}`,
  `--case-heading: ${headingInk}`,
  `--case-dark: ${theme.dark}`,
  `--case-light: ${theme.light}`,
  `--case-cover: url(${closingCover.src})`,
  closingLogo ? `--case-logo: url(${closingLogo.src})` : '',
]
  .filter(Boolean)
  .join('; ');
const nextStyle = `--next-accent: ${nextTheme.accent}; --next-dark: ${nextTheme.dark};`;
const facts = [
  { label: 'Client', value: data.clients.join(', ') },
  { label: 'Sector', value: data.sectors.join(', ') },
  { label: 'Services', value: data.services.join(', ') },
].filter((fact) => fact.value);

const url = new URL(caseStudyUrl(study), Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: data.headline,
    name: data.title,
    description: data.description,
    datePublished: data.date.toISOString(),
    author: { '@id': `${Astro.site}#organization` },
    publisher: { '@id': `${Astro.site}#organization` },
    mainEntityOfPage: url,
    about: data.clients.map((name) => ({ '@type': 'Organization', name })),
    keywords: [...data.services, ...data.sectors].join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: 'Case Studies', item: new URL('/case-studies/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: data.title, item: url },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogImage={data.cover}
  ogImageAlt={data.coverAlt}
  ogType="article"
  article={{ published: data.date, section: 'Case Studies', tags: [...data.services, ...data.sectors] }}
  jsonLd={jsonLd}
>
  <article style={themeStyle}>
    <!-- Hero: the live page's shifting gradient in the study's colors -->
    <header class="case-hero under-header">
      <div class="container case-hero__text" data-intro>
        <nav aria-label="Breadcrumb" class="case-hero__breadcrumb">
          <a href="/case-studies/">Case Studies</a>
        </nav>
        <p class="case-hero__eyebrow">{data.eyebrow}</p>
        <h1 class="case-hero__title">{data.headline}</h1>
        <p class="case-hero__subtitle">{data.subheadline}</p>
      </div>
    </header>

    <!-- Cover card: overlaps the hero, black and white until it scrolls into
         view, the photo drifting slower than the page, logo wiping in -->
    <div class="case-cover curve-top">
      <div class="container">
        <figure class="case-cover__card" data-reveal="color">
          <Image
            class="case-cover__image"
            src={data.cover}
            alt={data.coverAlt}
            widths={[640, 1280, 1920]}
            sizes="(max-width: 1240px) 100vw, 1200px"
            loading="eager"
            fetchpriority="high"
          />
          {data.logo && <Image class="case-cover__logo" src={data.logo} alt={data.logoAlt ?? ''} height={96} />}
        </figure>
        {
          facts.length > 0 && (
            <dl class="case-facts">
              {facts.map((fact) => (
                <div>
                  <dt>{fact.label}</dt>
                  <dd>{fact.value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>

    <div class="case-story">
      <Content />
    </div>
  </article>

  {data.showSiteLaunch && <SiteLaunchSection />}

  <!-- Next case study, set in the next client's colors -->
  <section class="case-next curve-top" style={nextStyle} aria-labelledby="case-next-heading">
    <div class="container case-next__inner">
      <div class="case-next__text">
        <p class="case-next__label">Next case study</p>
        <h2 id="case-next-heading" class="case-next__title">
          <a href={caseStudyUrl(next)}>
            <span>{next.data.headline}</span>
            <Icon name="arrow-up-right" size={40} />
          </a>
        </h2>
        <p class="case-next__client">{next.data.clients.join(', ')}</p>
      </div>
      <div class="case-next__media">
        <Image src={next.data.cover} alt={next.data.coverAlt} widths={[480, 960]} sizes="(max-width: 977px) 100vw, 560px" />
      </div>
    </div>
  </section>

  <OurWork exclude={study.id} />
</BaseLayout>

<style>
  /* Hero */
  .case-hero {
    position: relative;
    padding-block: calc(var(--header-height) + 5rem) calc(var(--cover-lift) + 4rem);
    background: linear-gradient(-45deg, var(--color-black), var(--case-accent), var(--case-dark)) 0% 50% / 400% 400%;
    animation: case-gradient 7s ease infinite;
  }

  @keyframes case-gradient {
    50% {
      background-position: 100% 50%;
    }
  }

  .case-hero__text {
    display: grid;
    justify-items: center;
    gap: var(--space-sm);
    text-align: center;
  }

  .case-hero__breadcrumb a {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .case-hero__breadcrumb a:hover {
    color: var(--color-white);
  }

  .case-hero__eyebrow {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .case-hero__title {
    max-width: 14em;
    margin: 0;
    font-weight: var(--font-weight-regular);
    text-shadow: var(--text-glow);
  }

  .case-hero__subtitle {
    max-width: 48rem;
    margin: 0;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
  }

  /* Cover card */
  /* The cover card rises out of the white band over the hero, starting
   * above the curve so the curve's lowest point tucks under it, as on the
   * live site. flow-root keeps the card's negative margin from collapsing
   * through to the band (which would drag the curve up with it). */
  .case-cover {
    --curve-color: var(--color-white);
    display: flow-root;
    padding-bottom: var(--space-xl);
    background-color: var(--color-white);
  }

  .case-cover__card {
    position: relative;
    display: grid;
    place-items: center;
    z-index: 2;
    margin: calc(-1 * var(--cover-lift)) 0 0;
    aspect-ratio: 1200 / 632;
    overflow: hidden;
    isolation: isolate;
    border: 2px solid var(--color-white);
    border-radius: var(--radius-card);
    background-color: var(--case-dark);
    box-shadow: 0 30px 60px rgb(0 0 0 / 0.25);
  }

  .case-cover__image {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }

  /* Study color veil over the photo */
  .case-cover__card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: color-mix(in srgb, var(--case-dark) 70%, transparent);
  }

  .case-cover__logo {
    width: auto;
    max-width: min(22rem, 50%);
    height: auto;
    max-height: 9rem;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .case-cover__image {
        animation: cover-parallax linear both;
        animation-timeline: view();
      }
    }
  }

  @keyframes cover-parallax {
    from {
      transform: translateY(-6%);
    }
    to {
      transform: translateY(6%);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Black and white until it scrolls into view, then full color */
    :global(.js) .case-cover__card {
      filter: grayscale(1);
      transition: filter 1.2s var(--ease-out);
    }

    :global(.js) .case-cover__card:global(.is-revealed) {
      filter: none;
    }

    /* The logo wipes in left to right */
    :global(.js) .case-cover__logo {
      -webkit-mask: linear-gradient(90deg, #000 0 40%, transparent 60% 100%) 100% 0 / 250% 100% no-repeat;
      mask: linear-gradient(90deg, #000 0 40%, transparent 60% 100%) 100% 0 / 250% 100% no-repeat;
      transition:
        -webkit-mask-position 1.8s var(--ease-out) 0.25s,
        mask-position 1.8s var(--ease-out) 0.25s;
    }

    :global(.js) .case-cover__card:global(.is-revealed) .case-cover__logo {
      -webkit-mask-position: 0 0;
      mask-position: 0 0;
    }
  }

  /* Facts strip: hairline-divided cells */
  .case-facts {
    display: flex;
    flex-wrap: wrap;
    margin: var(--space-lg) 0 0;
    border-block: 1px solid color-mix(in srgb, var(--case-dark) 20%, transparent);
    color: var(--case-dark);
  }

  .case-facts div {
    display: flex;
    flex: 1 1 12rem;
    gap: var(--space-xs);
    align-items: baseline;
    padding: var(--space-sm) var(--space-md);
  }

  .case-facts div + div {
    border-left: 1px solid color-mix(in srgb, var(--case-dark) 20%, transparent);
  }

  .case-facts dt {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .case-facts dd {
    margin: 0;
    font-weight: var(--font-weight-semibold);
  }

  /* ===== The story: bands built by src/lib/case-study-bands.mjs ===== */
  .case-story :global(.case-band) {
    --band-text: var(--case-dark);
    --band-heading: var(--case-heading);
    --band-strong: var(--case-dark);
    --band-link: var(--case-dark);
    position: relative;
    padding-block: clamp(4rem, 3rem + 4vw, 6.3rem);
    background-color: var(--color-white);
    color: var(--band-text);
  }

  .case-story :global(.case-band[data-tone='light']) {
    background-color: var(--case-light);
  }

  .case-story :global(.case-band[data-tone='neutral']) {
    background-color: var(--color-neutral-lighter);
  }

  .case-story :global(.case-band:is([data-tone='accent'], [data-tone='dark'])) {
    --band-text: rgb(255 255 255 / 0.85);
    --band-heading: var(--color-white);
    --band-strong: var(--color-white);
    --band-link: var(--color-mint);
    background-color: var(--case-accent);
  }

  .case-story :global(.case-band[data-tone='dark']) {
    background-color: var(--case-dark);
  }

  .case-story :global(.case-band__inner) {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
    width: 100%;
    max-width: calc(var(--container-max) + 2 * var(--container-gutter));
    margin-inline: auto;
    padding-inline: var(--container-gutter);
  }

  .case-story :global(h2) {
    margin: 0;
    color: var(--band-heading);
    font-weight: 200;
  }

  .case-story :global(h3) {
    margin: 0 0 var(--space-xs);
    color: var(--band-strong);
    font-size: clamp(1.75rem, 1.3rem + 1.5vw, 2.5rem);
    font-weight: var(--font-weight-medium);
  }

  .case-story :global(h4) {
    margin: 0 0 var(--space-2xs);
    color: var(--band-strong);
    font-family: var(--font-body);
    font-size: 1.25rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: normal;
  }

  .case-story :global(p),
  .case-story :global(ul) {
    margin: 0 0 var(--space-sm);
  }

  .case-story :global(:is(p, ul, ol):last-child) {
    margin-bottom: 0;
  }

  .case-story :global(strong) {
    color: var(--band-strong);
    font-weight: var(--font-weight-semibold);
  }

  .case-story :global(a) {
    color: var(--band-link);
    font-weight: var(--font-weight-semibold);
  }

  .case-story :global(:focus-visible) {
    outline-color: currentColor;
  }

  .case-story :global(ul) {
    padding-left: 1.2em;
  }

  .case-story :global(li + li) {
    margin-top: var(--space-2xs);
  }

  .case-story :global(img),
  .case-story :global(video) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-card);
  }

  /* Band headers */
  .case-story :global(.case-header) {
    display: grid;
    gap: var(--space-sm);
    max-width: 50rem;
  }

  .case-story :global(.case-header--center) {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }

  .case-story :global(.case-header > p:not(.case-kicker)) {
    font-size: var(--font-size-lg);
  }

  .case-story :global(.case-kicker) {
    margin: 0;
    color: var(--band-strong);
    font-family: var(--font-mono);
    font-size: 1rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Intro: the big opening question, in the study's color */
  .case-story :global(.case-header--intro) {
    max-width: none;
    text-align: center;
  }

  .case-story :global(.case-header.case-header--intro > p) {
    color: var(--band-heading);
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 3vw, 4rem);
    font-weight: 200;
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    text-wrap: balance;
  }

  .case-story :global(.case-band:first-child) {
    padding-top: 0;
  }

  /* Statement band */
  .case-story :global(.case-band--statement) {
    padding-block: clamp(3.5rem, 2.5rem + 3vw, 4.5rem);
  }

  .case-story :global(.statement) {
    max-width: 50rem;
    margin: 0 auto;
    color: var(--color-white);
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3.75rem);
    letter-spacing: var(--tracking-display);
    line-height: 1.05;
    text-align: center;
    text-wrap: balance;
  }

  /* Challenge rows: a label column beside problem and approach cards */
  .case-story :global(.case-challenge) {
    display: grid;
    gap: var(--space-xl);
  }

  .case-story :global(.case-challenge__row) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--space-md);
  }

  .case-story :global(.case-challenge__label :is(h2, h3)) {
    margin: 0 0 var(--space-xs);
    color: var(--band-strong);
    font-family: var(--font-body);
    font-size: clamp(1.4rem, 1.2rem + 0.6vw, 1.625rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: normal;
  }

  .case-story :global(.case-challenge__label p) {
    font-size: var(--font-size-lg);
  }

  .case-story :global(.case-challenge__cards) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-story :global(.case-point) {
    --point-bg: var(--color-problem-bg);
    --point-line: var(--color-problem-line);
    --point-icon: var(--color-problem-icon);
    --point-text: var(--color-problem-text);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 11.875rem;
    margin: 0;
    padding: var(--space-sm);
    border: 1px solid var(--point-line);
    border-radius: var(--radius-lg);
    background-color: var(--point-bg);
    color: var(--point-text);
    transition:
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .case-story :global(.case-point:hover) {
    transform: translateY(-3px);
    box-shadow: 0 12px 24px color-mix(in srgb, var(--point-line) 30%, transparent);
  }

  .case-story :global(.case-point--win) {
    --point-bg: var(--color-win-bg);
    --point-line: var(--color-win-line);
    --point-icon: var(--color-win-text);
    --point-text: var(--color-win-text);
  }

  .case-story :global(.case-point__icon) {
    display: grid;
    place-items: center;
    align-self: flex-end;
    width: 3.5rem;
    height: 3.5rem;
    border: 1px solid var(--point-line);
    border-radius: var(--radius-md);
    background-color: var(--color-white);
    color: var(--point-icon);
  }

  .case-story :global(.case-point__icon svg) {
    border-radius: 0;
  }

  .case-story :global(.case-point p) {
    color: inherit;
    font-size: var(--font-size-lg);
    line-height: 1.6;
  }

  /* Text beside media */
  .case-story :global(.case-feature) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }

  .case-story :global(.case-feature--reverse .case-feature__text) {
    order: 2;
  }

  .case-story :global(.case-feature__text > :is(h3, h4):not(:first-child)) {
    margin-top: var(--space-lg);
  }

  .case-story :global(.case-feature__media) {
    display: grid;
    gap: var(--space-md);
  }

  /* Image cards, two to a row: picture, heading, words */
  .case-story :global(.case-cards) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2xl) var(--space-xl);
  }

  .case-story :global(.case-card__media) {
    display: grid;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .case-story :global(.case-card__media img) {
    transition: transform 800ms var(--ease-out);
  }

  .case-story :global(.case-card:hover .case-card__media img) {
    transform: scale(1.02);
  }

  /* Short text subsections as columns with hairline tops */
  .case-story :global(.case-columns) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-xl);
  }

  .case-story :global(.case-column) {
    padding-top: var(--space-md);
    border-top: 1px solid color-mix(in srgb, currentColor 25%, transparent);
  }

  .case-story :global(.case-block) {
    display: grid;
    gap: var(--space-sm);
  }

  .case-story :global(.case-block > :is(p, ul, h3, h4)) {
    max-width: 46rem;
    margin: 0;
  }

  /* Galleries */
  .case-story :global(.case-gallery) {
    display: grid;
    grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr));
    gap: var(--space-md);
    align-items: start;
  }

  .case-story :global(.case-gallery[data-count='3']) {
    --cols: 3;
  }

  .case-story :global(.case-gallery[data-count='4']) {
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }

  .case-story :global(.case-gallery > p) {
    margin: 0;
  }

  /* Process steps: rounded gray cells with big serif numbers */
  .case-story :global(ol) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .case-story :global(ol > li) {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: var(--space-sm);
    align-items: center;
    margin: 0;
    padding: var(--space-sm) var(--space-md) var(--space-sm) var(--space-sm);
    border-radius: var(--radius-card);
    background-color: var(--color-step);
    color: var(--color-black);
    font-size: 0.9rem;
    line-height: 1.5;
    counter-increment: step;
    transition:
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .case-story :global(ol > li:hover) {
    background-color: var(--case-light);
    transform: translateY(-2px);
  }

  .case-story :global(ol > li::before) {
    content: counter(step, decimal-leading-zero);
    font-family: var(--font-display);
    font-size: 3.75rem;
