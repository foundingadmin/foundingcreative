---
import Img from '../components/Img.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Testimonials from '../components/Testimonials.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Carousel from '../components/Carousel.astro';
import Icon from '../components/Icon.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import { getCaseStudies } from '../lib/content';
import { team } from '../data/team';

// Case studies for the service sliders, by folder name, in the order given.
const allStudies = await getCaseStudies();
const pick = (ids: string[]) =>
  ids.map((id) => allStudies.find((study) => study.id === id)).filter((study) => study !== undefined);

// The three services, in the order the pinned "We shape brands / launch
// websites / support events" line cycles through them. Each shows its case
// studies two at a time (aim for six per service as more are written).
const services = [
  {
    title: 'We shape brands',
    words: 'shape brands',
    lead: 'Brand identities built to last through clear, scalable creative foundations.',
    href: '/services/branding-services/',
    cta: 'Branding services',
    tags: ['Brand strategy', 'Visual identity', 'Guidelines', 'Creative copywriting'],
    studies: pick(['bell-bird-atm', 'safezone-product-and-branding', 'genpact-grow-event', 'plant-nursery-ecommerce']),
  },
  {
    title: 'We launch websites',
    words: 'launch websites',
    lead: 'No two sites should be the same because no two businesses are.',
    href: '/services/website-services/',
    cta: 'Website services',
    tags: ['User journeys', 'Design systems', 'Content strategy', 'Custom dev', 'Integrations'],
    studies: pick(['turntide-website', 'atlfreight-website', 'plant-nursery-ecommerce', 'aprilaire-product-app']),
  },
  {
    title: 'We support events',
    words: 'support events',
    lead: 'Crafting environments for unforgettable experiences.',
    href: '/services/event-services/',
    cta: 'Event services',
    tags: ['Event branding', 'Trade show exhibits', 'Signage and wayfinding', 'Presentations', 'Post-event content'],
    studies: pick(['innovation-forum-event', 'bank-apps', 'interactive-learning-mural', 'genpact-grow-event']),
  },
];

const trustpilot = 'https://www.trustpilot.com/review/foundingcreative.com';
// Team portraits in the live site's order
const crew = team(['tyler', 'stacey', 'jamie', 'titus', 'sasha', 'blake']);

const values = [
  { title: 'Clarity over chaos', text: 'Solutions rooted in structure and strategy' },
  { title: 'Relationships first', text: 'We work with people, not logos' },
  { title: 'Creative systems', text: 'Always building together to drive outcomes' },
  { title: 'Founding energy', text: 'Every project is a chance for something big' },
];
---

<!-- Organization (with ProfessionalService) and WebSite structured data
     come from SEO.astro, in full on this page -->
<BaseLayout>
  <!-- Hero: the four-color gradient drifting under the wave and a dark veil
       (as on About), with the pearl headline glowing on top -->
  <section class="hero under-header">
    <HeroBackdrop />
    <div class="container hero__content" data-intro>
      <p class="hero__eyebrow">Brand strategy and web design agency</p>
      <h1 class="hero__title holo-text">Creative foundations for brands of all sizes</h1>
      <p class="hero__lead">
        We're a brand strategy agency for growing B2B teams. We build the{' '}
        <a href="/services/branding-services/">brand</a>, <a href="/services/website-services/">website</a>,{' and '}
        <a href="/services/design-services/">design system</a> your team grows on, strategy first.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="/case-studies/">See our case studies <Icon name="arrow-up-right" size={16} /></a>
        <a class="button" href="#services">Explore our services <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services curve-bottom" id="services" aria-labelledby="services-heading">
    <div class="container section">
      <div class="section__intro">
        <!-- The services below speak for themselves; the heading is for screen
             readers and the outline only. -->
        <p class="eyebrow" aria-hidden="true">Our <em>services</em></p>
        <h2 id="services-heading" class="visually-hidden">Our services</h2>
      </div>

      <!-- Pinned line: the phrase swaps as each service passes the middle of
           the screen (script below). Decorative; each service's H3 says the
           same, and shows in its place on small screens. -->
      <p class="cycler" aria-hidden="true" data-cycler>
        <span class="cycler__we">We</span>
        <span class="cycler__words">
          {
            services.map((service, i) => (
              <span class:list={['cycler__word', { 'is-active': i === 0 }]}>{service.words}</span>
            ))
          }
        </span>
      </p>

      {
        services.map((service, i) => (
          <article class="service" aria-labelledby={`service-${i}`} data-reveal data-cycler-step={i}>
            <div class="service__text">
              <h3 id={`service-${i}`}>{service.title}</h3>
              <p class="service__lead">{service.lead}</p>
              <a class="button" href={service.href}>
                {service.cta} <Icon name="arrow-up-right" size={16} />
              </a>
            </div>
            <div class="service__media">
              <ul class="service__tags" aria-label={`${service.title}: what's included`}>
                {service.tags.map((tag) => (
                  <li class="pill">{tag}</li>
                ))}
              </ul>
              <Carousel id={`service-${i}-work`} label={`${service.title}: case studies`} class="service__gallery">
                {service.studies.map((study) => (
                  <li>
                    <CaseStudyCard study={study} headingLevel={4} compact />
                  </li>
                ))}
              </Carousel>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-band" aria-labelledby="testimonials-heading">
    <div class="container section">
      <div class="section__intro section__intro--center section__intro--wide">
        <p class="eyebrow">Partner <em>testimonials</em></p>
        <h2 id="testimonials-heading">Proof is better than a pitch</h2>
        <p class="section__lead">See what it's like to work with a creative team that builds for the long run.</p>
      </div>
      <ClientLogos />
      <Testimonials />
      <p class="section__more">
        <a class="button button--primary" href={trustpilot}>
          View all testimonials <Icon name="arrow-up-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <!-- Who we are -->
  <section class="about-band curve-top" aria-labelledby="about-heading">
    <div class="container section about">
      <ul class="team" aria-label="The Founding Creative team" data-reveal-stagger>
        {
          crew.map((person) => (
            <li>
              <Img src={person.photo} alt={person.name} widths={[240, 480]} sizes="(max-width: 700px) 30vw, 180px" />
            </li>
          ))
        }
      </ul>
      <div data-reveal>
        <p class="eyebrow">Who <em>we are</em></p>
        <h2 id="about-heading">Built by creatives. Backed by strategy.</h2>
        <p class="section__lead">
          With too many businesses stuck between bloated agencies and scattered freelancers, we built the creative agency we
          always wished existed.
        </p>
        <ul class="values">
          {
            values.map((value) => (
              <li>
                <Icon name="check" size={16} />
                <span>
                  <strong>{value.title}:</strong> {value.text}
                </span>
              </li>
            ))
          }
        </ul>
        <a class="button" href="/about-us/">Meet the team <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-height) + 4.5rem) var(--space-xl);
  }

  .hero__content {
    position: relative;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-2xs);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-bold);
    line-height: 1.5;
  }

  .hero__title {
    max-width: 10.6em;
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-medium);
  }

  .hero__lead {
    max-width: 40rem;
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.5rem);
  }

  .hero__lead a {
    text-decoration: none;
    transition: text-shadow var(--transition-fast);
  }

  .hero__lead a:hover {
    text-shadow: var(--text-glow);
  }

  .hero__lead a:nth-of-type(1) {
    color: var(--color-holo-cyan);
  }

  .hero__lead a:nth-of-type(2) {
    color: var(--color-holo-mint);
  }

  .hero__lead a:nth-of-type(3) {
    color: var(--color-lavender);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }

  /* Services: rows split by hairlines, like the live site */
  .services {
    --curve-color: var(--color-night);
    z-index: 2;
    background-color: var(--color-night);
  }

  /* "We shape brands / launch websites / support events": pinned under the
   * header while the services scroll beneath it; the phrase blurs and scales
   * between states. */
  .cycler {
    position: sticky;
    top: var(--header-height);
    z-index: 1;
    display: flex;
    gap: 0.25em;
    margin: 0;
    padding-block: var(--space-md) var(--space-lg);
    background: linear-gradient(var(--color-night) 75%, transparent);
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.5rem + 4vw, 6rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .cycler__words {
    display: grid;
  }

  .cycler__word {
    grid-area: 1 / 1;
    color: var(--color-mint);
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.92);
    transform-origin: left center;
    transition:
      opacity 500ms var(--ease-out),
      filter 500ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .cycler__word.is-active {
    opacity: 1;
    filter: none;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cycler__word {
      transition: none;
    }
  }

  @media (max-width: 977px) {
    .cycler {
      display: none;
    }
  }

  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: var(--space-2xl);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-hairline);
  }

  .service__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .service h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: normal;
    line-height: 1.4;
  }

  /* The pinned line is the visible heading on wide screens; the H3 stays
   * for screen readers and the outline */
  @media (min-width: 978px) {
    .service h3 {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  .service__lead {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0 0 var(--space-sm);
    padding: 0;
    list-style: none;
  }

  /* Case studies two at a time; the arrows bring on the next two. The
   * Carousel class lands outside this page's style scope. */
  .service__media :global(.service__gallery) {
    --slide-gap: var(--space-md);
    --slide-width: calc((100% - var(--slide-gap)) / 2);
  }

  /* Room for the card hover lift and glow inside the scrolling row */
  .service__media :global(.service__gallery .carousel__track) {
    padding-block: var(--space-sm) var(--space-lg);
  }

  /* One card at a time on phones, with the next peeking in */
  @media (max-width: 599px) {
    .service__media :global(.service__gallery) {
      --slide-width: 100%;
    }
  }

  /* Testimonials band */
  .testimonials-band {
    background-color: var(--color-coal);
  }

  .section__intro--wide {
    max-width: 56rem;
  }

  /* Who we are */
  /* Who we are runs down into dark gray, so the page's lifting edge reads
     clearly against the CTA and footer beneath it */
  .about-band {
    --curve-color: var(--color-night);
    background: linear-gradient(var(--color-night), var(--color-ink));
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Portraits in black and white, warming to color on hover */
  .team img {
    width: 100%;
    aspect-ratio: 169 / 250;
    object-fit: cover;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-lg);
    background-color: rgb(255 255 255 / 0.5);
    filter: grayscale(1);
    transition:
      filter 600ms var(--ease-out),
      transform 600ms var(--ease-out);
  }

  .team li:hover img {
    filter: grayscale(0);
    transform: translateY(-4px);
  }

  .values {
    display: grid;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }

  .values li {
    display: flex;
    gap: var(--space-xs);
  }

  .values .icon {
    margin-top: 0.35em;
    color: var(--color-white);
  }

  .values strong {
    font-weight: var(--font-weight-bold);
  }

  @media (max-width: 977px) {
    .service,
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>

<script>
  // Swap the pinned phrase to whichever service is crossing the middle of the screen.
  const cycler = document.querySelector('[data-cycler]');
  if (cycler) {
    const words = [...cycler.querySelectorAll('.cycler__word')];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const active = Number((entry.target as HTMLElement).dataset.cyclerStep);
          words.forEach((word, i) => word.classList.toggle('is-active', i === active));
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    document.querySelectorAll('[data-cycler-step]').forEach((step) => observer.observe(step));
  }
</script>
