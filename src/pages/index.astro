---
import Img from '../components/Img.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientLogos from '../components/ClientLogos.astro';
import Testimonials from '../components/Testimonials.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Carousel from '../components/Carousel.astro';
import Icon from '../components/Icon.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import { getCollection } from 'astro:content';
import { getCaseStudies } from '../lib/content';
import { team } from '../data/team';

// Case studies for the service sliders, by folder name, in the order given.
const allStudies = await getCaseStudies();
const pick = (ids: string[]) =>
  ids.map((id) => allStudies.find((study) => study.id === id)).filter((study) => study !== undefined);

// The services, in the order the pinned "We shape brands / launch websites /
// transform events / design everything" line cycles through them. The first
// three show their case studies two at a time (aim for six per service as
// more are written); the last is a smaller row with no case studies.
// Each service's pills are the sections ("areas") of its service page, set
// in src/content/services/*.yaml: the pill links to that section's anchor.
const servicePages = await getCollection('services');
const pills = (path: string): { label: string; href?: string }[] =>
  (servicePages.find((page) => page.data.path === path)?.data.areas?.items ?? []).map((area) => ({
    label: area.label,
    href: `${path}#${area.id}`,
  }));

const services = [
  {
    title: 'We shape brands',
    words: 'shape brands',
    lead: "From core positioning to complete visual systems, let's craft strategic, cohesive brand identities that carry the business forward as it grows.",
    href: '/services/branding-services/',
    cta: 'View all brand services',
    tags: pills('/services/branding-services/'),
    studies: pick(['bell-bird-atm', 'safezone-product-and-branding', 'genpact-grow-event', 'plant-nursery-ecommerce']),
  },
  {
    title: 'We launch websites',
    words: 'launch websites',
    lead: "Custom, high-performing websites built to engage users, showcase your company's credibility, convert prospects to sales, and scale with ease.",
    href: '/services/website-services/',
    cta: 'View all website services',
    tags: pills('/services/website-services/'),
    studies: pick(['turntide-website', 'atlfreight-website', 'plant-nursery-ecommerce', 'aprilaire-product-app']),
  },
  {
    title: 'We transform events',
    words: 'transform events',
    lead: 'Strategic event themes seamlessly executed across interactive displays and large-format graphics, turning ordinary moments into immersive, memorable brand experiences.',
    href: '/services/event-services/',
    cta: 'View all event services',
    tags: pills('/services/event-services/'),
    studies: pick(['innovation-forum-event', 'bank-apps', 'interactive-learning-mural', 'genpact-grow-event']),
  },
  {
    title: 'We design everything',
    words: 'design everything',
    lead: 'Consider us your on-call creative partner for any asset imaginable. We turn ambitious ideas into polished reality with impactful deliverables that keep your brand consistent across the board.',
    href: '/services/design-services/',
    cta: 'View all design services',
    // Plain labels: the design services page has no sections to link to.
    tags: ['Digital marketing', 'Print collateral', 'Packaging', 'Presentations', 'Sales enablement'].map(
      (label): { label: string; href?: string } => ({ label }),
    ),
    studies: [],
  },
];

const trustpilot = 'https://www.trustpilot.com/review/foundingcreative.com';
// Team portraits in the live site's order
const crew = team(['tyler', 'stacey', 'jamie', 'titus', 'sasha', 'blake']);

const values = [
  { title: 'Clarity over chaos', text: 'Solutions rooted in structure and strategy' },
  { title: 'Relationships first', text: 'We work with people, not logos' },
  { title: 'Creative systems', text: 'Always building together to drive outcomes' },
  { title: 'Founding energy', text: 'Every project is a chance for something big' },
];
---

<!-- Organization (with ProfessionalService) and WebSite structured data
     come from SEO.astro, in full on this page -->
<BaseLayout>
  <!-- Hero: the four-color gradient drifting under the wave and a dark veil
       (as on About), with the pearl headline glowing on top -->
  <section class="hero under-header">
    <HeroBackdrop />
    <div class="container hero__content" data-intro>
      <p class="hero__eyebrow">Brand strategy and web design agency</p>
      <h1 class="hero__title holo-text">Your complete creative department, built on strategy.</h1>
      <p class="hero__lead">
        We're a full-service creative partner for scaling companies. From{' '}
        <a href="/services/branding-services/">brand identity</a> and{' '}
        <a href="/services/website-services/">websites</a> to <a href="/services/event-services/">live events</a> and{' '}
        <a href="/services/design-services/">ongoing design support</a>, we build the creative foundations modern
        businesses need to stand out and grow.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="/case-studies/">See our case studies <Icon name="arrow-up-right" size={16} /></a>
        <a class="button" href="/services/">Explore our services <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="services curve-bottom" id="services" aria-labelledby="services-heading">
    <div class="container section">
      <div class="section__intro">
        <!-- The services below speak for themselves; the heading is for screen
             readers and the outline only. -->
        <p class="eyebrow" aria-hidden="true">Our <em>services</em></p>
        <h2 id="services-heading" class="visually-hidden">Our services</h2>
      </div>

      <!-- Pinned line: the phrase swaps as each service passes the middle of
           the screen (script below), and the whole line links to that
           service's page. It is a mouse shortcut only (hidden from screen
           readers, out of the tab order): each service's H3 says the same
           and carries the real link, and shows in its place on small screens. -->
      <p class="cycler" aria-hidden="true" data-cycler>
        <a class="cycler__link" href={services[0].href} tabindex="-1" data-cycler-link>
          <span class="cycler__we">We</span>
          <span class="cycler__words">
            {
              services.map((service, i) => (
                <span class:list={['cycler__word', { 'is-active': i === 0 }]} data-href={service.href}>
                  {service.words}
                  <Icon name="arrow-up-right" size={32} class="cycler__arrow" />
                </span>
              ))
            }
          </span>
        </a>
      </p>

      {
        services.map((service, i) => (
          <article
            class:list={['service', { 'service--compact': service.studies.length === 0 }]}
            aria-labelledby={`service-${i}`}
            data-reveal
            data-cycler-step={i}
          >
            <div class="service__text">
              <h3 id={`service-${i}`}>
                <a class="service__title" href={service.href}>
                  {service.title}
                  <Icon name="arrow-up-right" size={20} class="service__title-arrow" />
                </a>
              </h3>
              <p class="service__lead">{service.lead}</p>
              <div class="service__list">
                {/* What's included: a pill with a section on the service page jumps to it */}
                <ul class="service__tags" aria-label={`${service.title}: what's included`}>
                  {service.tags.map((tag) => (
                    <li>
                      {tag.href ? (
                        <a class="pill service__tag" href={tag.href}>
                          {tag.label}
                        </a>
                      ) : (
                        <span class="pill service__tag service__tag--plain">{tag.label}</span>
                      )}
                    </li>
                  ))}
                </ul>
                <a class="button" href={service.href}>
                  {service.cta} <Icon name="arrow-up-right" size={16} />
                </a>
              </div>
            </div>
            {service.studies.length > 0 && (
              <div class="service__media">
                <Carousel id={`service-${i}-work`} label={`${service.title}: case studies`} class="service__gallery">
                  {service.studies.map((study) => (
                    <li>
                      <CaseStudyCard study={study} headingLevel={4} compact />
                    </li>
                  ))}
                </Carousel>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <!-- About and testimonials, as one section: who we are, then the people
       and brands who vouch for it -->
  <section class="about-band" aria-labelledby="about-heading">
    <div class="container section about">
      <ul class="team" aria-label="The Founding Creative team" data-reveal-stagger>
        {
          crew.map((person) => (
            <li>
              <Img src={person.photo} alt={person.name} widths={[240, 480]} sizes="(max-width: 700px) 30vw, 180px" />
            </li>
          ))
        }
      </ul>
      <div data-reveal>
        <p class="eyebrow">Who <em>we are</em></p>
        <h2 id="about-heading">Built by creatives. Backed by strategy.</h2>
        <p class="section__lead">
          With too many businesses stuck between bloated agencies and scattered freelancers, we built the creative agency we
          always wished existed.
        </p>
        <ul class="values">
          {
            values.map((value) => (
              <li>
                <Icon name="check" size={16} />
                <span>
                  <strong>{value.title}:</strong> {value.text}
                </span>
              </li>
            ))
          }
        </ul>
        <a class="button" href="/about-us/">Meet the team <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </div>
    <div class="container section proof">
      <div class="section__intro section__intro--center section__intro--wide">
        <p class="eyebrow">Partner <em>testimonials</em></p>
        <h3 id="testimonials-heading" class="proof__heading">Proof is better than a pitch</h3>
        <p class="section__lead">See what it's like to work with a creative team that builds for the long run.</p>
      </div>
      <p class="proof__industries">
        Trusted by teams in finance, technology, logistics, construction, and consumer brands.
      </p>
      <ClientLogos />
      <Testimonials />
      <p class="section__more">
        <a class="button button--primary" href={trustpilot}>
          View all testimonials <Icon name="arrow-up-right" size={16} />
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-height) + 4.5rem) var(--space-xl);
  }

  .hero__content {
    position: relative;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-2xs);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-bold);
    line-height: 1.5;
  }

  .hero__title {
    max-width: 10.6em;
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-medium);
  }

  .hero__lead {
    max-width: 40rem;
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.5rem);
  }

  .hero__lead a {
    text-decoration: none;
    transition: text-shadow var(--transition-fast);
  }

  .hero__lead a:hover {
    text-shadow: var(--text-glow);
  }

  .hero__lead a:nth-of-type(1) {
    color: var(--color-holo-cyan);
  }

  .hero__lead a:nth-of-type(2) {
    color: var(--color-holo-mint);
  }

  .hero__lead a:nth-of-type(3) {
    color: var(--color-lavender);
  }

  .hero__lead a:nth-of-type(4) {
    color: var(--color-holo-cyan);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }

  /* Services: rows split by hairlines, like the live site */
  .services {
    --curve-color: var(--color-night);
    z-index: 2;
    background-color: var(--color-night);
  }

  /* "We shape brands / launch websites / support events": pinned under the
   * header while the services scroll beneath it; the phrase blurs and scales
   * between states. */
  .cycler {
    position: sticky;
    top: var(--header-height);
    z-index: 1;
    margin: 0;
    padding-block: var(--space-md) var(--space-lg);
    background: linear-gradient(var(--color-night) 75%, transparent);
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.5rem + 4vw, 6rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  /* The whole line is one link, only as wide as its words */
  .cycler__link {
    display: inline-flex;
    gap: 0.25em;
    color: inherit;
    text-decoration: none;
  }

  .cycler__words {
    display: grid;
  }

  /* A small arrow at the top right of the phrase: white, mint on hover */
  .cycler__word :global(.cycler__arrow) {
    width: 0.32em;
    height: 0.32em;
    margin-left: 0.08em;
    vertical-align: 0.55em;
    color: var(--color-white);
    transition:
      color 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .cycler__link:hover .cycler__word {
    text-shadow: 0 0 0.3em color-mix(in srgb, var(--color-mint) 65%, transparent);
  }

  .cycler__link:hover :global(.cycler__arrow) {
    color: var(--color-mint);
    transform: translate(0.06em, -0.06em);
  }

  /* Keyboard focus lands on the matching service's (visually hidden) H3
   * link; show it on the pinned line. */
  .services:has(.service__title:focus-visible) .cycler__link {
    outline: 2px solid var(--color-mint);
    outline-offset: 0.1em;
    border-radius: var(--radius-sm);
  }

  .cycler__word {
    grid-area: 1 / 1;
    color: var(--color-mint);
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.92);
    transform-origin: left center;
    transition:
      opacity 500ms var(--ease-out),
      filter 500ms var(--ease-out),
      transform 500ms var(--ease-out),
      text-shadow 200ms var(--ease-out);
  }

  .cycler__word.is-active {
    opacity: 1;
    filter: none;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cycler__word,
    .cycler__word :global(.cycler__arrow) {
      transition: none;
    }

    .cycler__link:hover :global(.cycler__arrow) {
      transform: none;
    }
  }

  @media (max-width: 977px) {
    .cycler {
      display: none;
    }
  }

  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: var(--space-2xl);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-hairline);
  }

  .service__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .service h3 {
    margin: 0;
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: normal;
    line-height: 1.4;
  }

  /* On small screens the H3 is the heading: a link with the same arrow */
  .service__title {
    color: inherit;
    text-decoration: none;
  }

  .service__title :global(.service__title-arrow) {
    width: 0.5em;
    height: 0.5em;
    vertical-align: 0.5em;
    color: var(--color-white);
    transition: color 200ms var(--ease-out);
  }

  .service__title:hover,
  .service__title:focus-visible {
    color: var(--color-mint);
  }

  .service__title:hover :global(.service__title-arrow),
  .service__title:focus-visible :global(.service__title-arrow) {
    color: var(--color-mint);
  }

  /* The pinned line is the visible heading on wide screens; the H3 stays
   * for screen readers and the outline */
  @media (min-width: 978px) {
    .service h3 {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  .service__lead {
    margin: 0;
    font-size: var(--font-size-lg);
  }

  /* The pills, then the service button */
  .service__list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
  }

  /* The last service has no case studies: its summary sits in the first
   * column and its list in the second, so the row stays short. */
  .service--compact {
    align-items: start;
    border-bottom: 0;
  }

  .service--compact .service__text {
    display: contents;
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .service__tag {
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 150ms var(--ease-out),
      background-color 150ms var(--ease-out),
      color 150ms var(--ease-out);
  }

  a.service__tag:hover,
  a.service__tag:focus-visible {
    border-color: var(--color-mint);
    background-color: var(--color-mint);
    color: var(--color-black);
  }

  /* Case studies two at a time; the arrows bring on the next two. The
   * Carousel class lands outside this page's style scope. */
  .service__media :global(.service__gallery) {
    --slide-gap: var(--space-md);
    --slide-width: calc((100% - var(--slide-gap)) / 2);
  }

  /* Room for the card hover lift and glow inside the scrolling row */
  .service__media :global(.service__gallery .carousel__track) {
    padding-block: var(--space-sm) var(--space-lg);
  }

  /* One card at a time on phones, with the next peeking in */
  @media (max-width: 599px) {
    .service__media :global(.service__gallery) {
      --slide-width: 100%;
    }
  }

  /* About and testimonials: one band that runs down into dark gray, so the
     page's lifting edge reads clearly against the CTA and footer beneath it */
  .about-band {
    background: linear-gradient(var(--color-night), var(--color-ink));
  }

  .section__intro--wide {
    max-width: 56rem;
  }

  /* Testimonials follow straight on from Who we are */
  .proof {
    padding-top: 0;
  }

  .proof__heading {
    font-size: var(--font-size-h2);
    font-weight: var(--font-weight-regular);
    line-height: var(--line-height-tight);
  }

  /* The industries line introduces the logo row */
  .proof__industries {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
    text-align: center;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Portraits in black and white, warming to color on hover */
  .team img {
    width: 100%;
    aspect-ratio: 169 / 250;
    object-fit: cover;
    border: 1px solid var(--color-text-muted);
    border-radius: var(--radius-lg);
    background-color: rgb(255 255 255 / 0.5);
    filter: grayscale(1);
    transition:
      filter 600ms var(--ease-out),
      transform 600ms var(--ease-out);
  }

  .team li:hover img {
    filter: grayscale(0);
    transform: translateY(-4px);
  }

  .values {
    display: grid;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-lg);
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }

  .values li {
    display: flex;
    gap: var(--space-xs);
  }

  .values .icon {
    margin-top: 0.35em;
    color: var(--color-white);
  }

  .values strong {
    font-weight: var(--font-weight-bold);
  }

  @media (max-width: 977px) {
    .service,
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
</style>

<script>
  // Swap the pinned phrase to whichever service is crossing the middle of the screen.
  const cycler = document.querySelector('[data-cycler]');
  if (cycler) {
    const words = [...cycler.querySelectorAll<HTMLElement>('.cycler__word')];
    const link = cycler.querySelector<HTMLAnchorElement>('[data-cycler-link]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const active = Number((entry.target as HTMLElement).dataset.cyclerStep);
          words.forEach((word, i) => word.classList.toggle('is-active', i === active));
          // The pinned line links to whichever service it is naming
          if (link && words[active]?.dataset.href) link.href = words[active].dataset.href;
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    document.querySelectorAll('[data-cycler-step]').forEach((step) => observer.observe(step));
  }
</script>
