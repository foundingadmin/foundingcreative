---
import type { ImageMetadata } from 'astro';
import Img from '../components/Img.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import ClientLogos from '../components/ClientLogos.astro';
import StatCards from '../components/StatCards.astro';
import { brandForgeSteps } from '../data/brandforge';
import ProcessCards from '../components/ProcessCards.astro';
import Testimonials from '../components/Testimonials.astro';
import OurWork from '../components/OurWork.astro';
import SelectedWorks from '../components/SelectedWorks.astro';
import Carousel from '../components/Carousel.astro';
import Icon from '../components/Icon.astro';
import HeroBackdrop from '../components/HeroBackdrop.astro';
import heroPoster from '../assets/home/hero/glowing-grid-poster.png';
import { heroBackdrop } from '../lib/images';
import mastercardLogo from '../assets/home/clients/mastercard-logo.png';
import bankOfAmericaLogo from '../assets/home/clients/bank-of-america-logo.png';
import honeywellLogo from '../assets/home/clients/honeywell-logo.png';
import tataLogo from '../assets/home/clients/tat-horizontal.png';
import volvoLogo from '../assets/home/clients/volvo-logo-solid.png';
import nissanLogo from '../assets/home/clients/nissan-logo-solid.png';
import { team } from '../data/team';

// Service sliders
import web1 from '../assets/home/services/web-1.webp';
import web2 from '../assets/home/services/web-2.webp';
import web3 from '../assets/home/services/web-3.webp';
import web4 from '../assets/home/services/web-4.webp';
import web5 from '../assets/home/services/web-5.webp';
import brand1 from '../assets/home/services/brand-1.webp';
import brand2 from '../assets/home/services/brand-2.webp';
import brand3 from '../assets/home/services/brand-3.webp';
import brand4 from '../assets/home/services/brand-4.webp';
import brand5 from '../assets/home/services/brand-5.webp';
import design1 from '../assets/home/services/design-1.webp';
import design2 from '../assets/home/services/design-2.webp';
import design3 from '../assets/home/services/design-3.webp';
import design4 from '../assets/home/services/design-4.webp';
import design5 from '../assets/home/services/design-5.webp';

// The three services, in the order the pinned "We design / develop / build"
// line cycles through them.
const services = [
  {
    icon: 'pen-tool',
    title: 'We design everything',
    word: 'design',
    lead: 'Design systems that ensure your brand consistently shines across all platforms.',
    text: 'From pitch decks to packaging, we deliver quality design consistently across every single one of your channels.',
    href: '/services/design-services/',
    cta: 'Design services',
    tags: ['Digital marketing', 'Print collateral', 'Packaging', 'Presentations', 'Sales enablement'],
    images: [
      { src: design1, alt: 'Construction worker using his phone at a glowing green Bell Bird ATM' },
      { src: design2, alt: 'Man presenting on a large TCS Business 4.0 interactive wall' },
      { src: design3, alt: '3D render of Turntide motors and controllers on white pedestals' },
      { src: design4, alt: 'Event graphic for speaker Steve Wozniak, co-founder of Apple' },
      { src: design5, alt: 'MODL branded hoodie with an orange line pattern' },
    ],
  },
  {
    icon: 'globe',
    title: 'We develop websites',
    word: 'develop',
    lead: 'No two sites should be the same because no two businesses are.',
    text: 'Our SiteLaunch system has three unique entry points, each tailored to unique business goals and growth stages.',
    href: '/services/website-services/',
    cta: 'Website services',
    tags: ['User journeys', 'Design systems', 'Content strategy', 'Custom dev', 'Integrations'],
    images: [
      { src: web1, alt: 'Laptop showing the Genpact GROW18 event website' },
      { src: web2, alt: 'Turntide website article pages on two phones' },
      { src: web3, alt: 'Huckleberry Holler plant page for the Mexican sunflower' },
      { src: web4, alt: 'Bank of America Public Sector app on a tablet beside a laptop' },
      { src: web5, alt: 'Turntide website homepage featuring a motor product render' },
    ],
  },
  {
    icon: 'flag',
    title: 'We build brands',
    word: 'build',
    lead: 'Brand identities built to last through clear, scalable creative foundations.',
    text: 'From brand strategy and copy to logo systems and style guides, we create the foundations that help brands grow with confidence.',
    href: '/services/branding-services/',
    cta: 'Branding services',
    tags: ['Brand strategy', 'Visual identity', 'Guidelines', 'Creative copywriting'],
    images: [
      { src: brand1, alt: 'Laptop showing a bold "Disrupt or be disrupted" brand graphic' },
      { src: brand2, alt: 'ATL Freight website on a laptop with the headline "Built on service, backed by integrity"' },
      { src: brand3, alt: 'Brand color palette swatches named Sky, Sea, Fern, Ash, Smoke, and Fog' },
      { src: brand4, alt: 'Hand-drawn logo sketches of an infinity loop on graph paper' },
      { src: brand5, alt: 'Genpact GROW18 event mural in a convention center' },
    ],
  },
] as const;

// First-screen proof: one 2025 number and a few recognizable clients. Each
// logo gets the same visual area, so wide wordmarks don't dwarf compact marks.
// Gallery tiles are 244x320 and crop landscape photos to fill the height,
// so the file needs to be as wide as the photo shows at that height.
const coverSizes = (img: ImageMetadata) => `${Math.ceil(Math.max(244, 320 * (img.width / img.height)))}px`;

const LOGO_AREA = 3200; // px²
const logoHeight = (logo: ImageMetadata) => Math.round(Math.sqrt(LOGO_AREA / (logo.width / logo.height)));
const heroClients = [
  { src: mastercardLogo, name: 'Mastercard' },
  { src: bankOfAmericaLogo, name: 'Bank of America' },
  { src: honeywellLogo, name: 'Honeywell' },
  { src: tataLogo, name: 'Tata' },
  { src: volvoLogo, name: 'Volvo' },
  { src: nissanLogo, name: 'Nissan' },
];

// 2025 in numbers, above the testimonials.
const yearStats = [
  { value: '28', label: 'clients' },
  { value: '800+', label: 'tasks delivered' },
  { value: '3,000+', label: 'hours of creative' },
  { value: '73%', label: 'of proposals won' },
];

const engagements = [
  {
    title: 'Fixed projects',
    icon: 'target',
    points: ['Clear scope', 'Defined timelines', 'Focused engagement'],
    text: 'Straightforward path from idea to launch through clearly defined scopes.',
    href: '/contact-us/',
    cta: "Let's talk",
  },
  {
    title: 'Fractional creative',
    icon: 'layers',
    featured: true,
    points: ['Priority access', 'Multiple work streams', 'Sliding scale cost'],
    text: 'Designed to reduce expenses for teams in need of regular creative support.',
    href: '/fractional-creative/',
    cta: 'Learn more',
  },
  {
    title: 'Custom fit',
    icon: 'puzzle',
    points: ['Creative ops guidance', 'Adapted to your systems', 'Built around your org'],
    text: 'Co-create the right structure for your unique goals, constraints, and vision.',
    href: '/contact-us/',
    cta: "Let's talk",
  },
];

const trustpilot = 'https://www.trustpilot.com/review/foundingcreative.com';
// Team portraits in the live site's order
const crew = team(['tyler', 'stacey', 'jamie', 'titus', 'sasha', 'blake']);

const values = [
  { title: 'Clarity over chaos', text: 'Solutions rooted in structure and strategy' },
  { title: 'Relationships first', text: 'We work with people, not logos' },
  { title: 'Creative systems', text: 'Always building together to drive outcomes' },
  { title: 'Founding energy', text: 'Every project is a chance for something big' },
];
---

<!-- Organization (with ProfessionalService) and WebSite structured data
     come from SEO.astro, in full on this page -->
<BaseLayout lcpImage={{ src: heroPoster, ...heroBackdrop }}>
  <!-- Hero: a looping glowing-grid video under a dark veil, with the pearl
       headline glowing on top -->
  <section class="hero under-header">
    <HeroBackdrop variant="video" video="/media/home/glowing-grid.mp4" image={heroPoster} />
    <div class="container hero__content" data-intro>
      <p class="hero__eyebrow">Brand strategy and web design agency</p>
      <h1 class="hero__title holo-text">Creative foundations for brands of all sizes</h1>
      <p class="hero__lead">
        We're a brand strategy agency for growing B2B teams. We build the{' '}
        <a href="/services/branding-services/">brand</a>, <a href="/services/website-services/">website</a>,{' and '}
        <a href="/services/design-services/">design system</a> your team grows on, strategy first.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="/case-studies/">See our case studies <Icon name="arrow-up-right" size={16} /></a>
        <a class="button" href="#services">Explore our services <Icon name="arrow-up-right" size={16} /></a>
      </div>
      <div class="hero__proof">
        <ul class="hero__clients" aria-label="Clients">
          {
            heroClients.map((client) => (
              <li style={`--logo-height: ${logoHeight(client.src)}px`}>
                <Img src={client.src} alt={client.name} height={logoHeight(client.src)} densities={[1, 2]} />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Selected works: three featured case studies -->
  <SelectedWorks />

  <!-- Services -->
  <section class="services curve-bottom" id="services" aria-labelledby="services-heading">
    <div class="container section">
      <div class="section__intro">
        <!-- The services below speak for themselves; the heading is for screen
             readers and the outline only. -->
        <p class="eyebrow" aria-hidden="true">Our <em>services</em></p>
        <h2 id="services-heading" class="visually-hidden">Our services</h2>
      </div>

      <!-- Pinned line: the verb swaps as each service passes the middle of the
           screen (script below). Decorative; each service's H3 says the same. -->
      <p class="cycler" aria-hidden="true" data-cycler>
        <span class="cycler__we">We</span>
        <span class="cycler__words">
          {
            services.map((service, i) => (
              <span class:list={['cycler__word', { 'is-active': i === 0 }]}>{service.word}</span>
            ))
          }
        </span>
      </p>

      {
        services.map((service, i) => (
          <article class="service" aria-labelledby={`service-${i}`} data-reveal data-cycler-step={i}>
            <div class="service__text">
              <div>
                <span class="service__icon">
                  <Icon name={service.icon} size={40} class="icon--draw" />
                </span>
                <h3 id={`service-${i}`}>{service.title}</h3>
                <p class="service__lead">{service.lead}</p>
                <p class="service__body">{service.text}</p>
              </div>
              <a class="button" href={service.href}>
                {service.cta} <Icon name="arrow-up-right" size={16} />
              </a>
            </div>
            <div class="service__media">
              <ul class="service__tags" aria-label={`${service.title}: what's included`}>
                {service.tags.map((tag) => (
                  <li class="pill">{tag}</li>
                ))}
              </ul>
              <Carousel id={`service-${i}-work`} label={`${service.title}: example work`} class="service__gallery">
                {service.images.map((image) => (
                  <li>
                    <Img
                      src={image.src}
                      alt={image.alt}
                      widths={[400, 600, 800, 1200].filter((w) => w <= image.src.width)}
                      sizes={coverSizes(image.src)}
                    />
                  </li>
                ))}
              </Carousel>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- BrandForge: the four steps from the Creative GTM deck, in its teal,
       as cards that open one at a time -->
  <section class="home-forge theme-forge" aria-labelledby="home-forge-heading">
    <div class="container section">
      <div class="section__intro section__intro--center">
        <p class="eyebrow"><span class="accent">Brand</span>Forge™ <em>for startups</em></p>
        <h2 id="home-forge-heading">From zero to market-ready in four steps</h2>
        <p class="section__lead">
          Research-backed brand strategy and identity, launch-ready in weeks instead of months.
        </p>
      </div>
      <div class="home-forge__cards">
        <ProcessCards steps={brandForgeSteps} id="home-forge-step" />
      </div>
      <a class="button button--primary home-forge__cta" href="/brandforge/">
        Explore BrandForge<span class="visually-hidden">, branding for startups</span>
        <Icon name="arrow-up-right" size={16} />
      </a>
    </div>
  </section>

  <!-- How we work -->
  <section class="engagement-band curve-top" aria-labelledby="engagement-heading">
    <div class="container section">
      <div class="section__intro section__intro--split">
        <div>
          <p class="eyebrow">How we <em>work</em></p>
          <h2 id="engagement-heading">Built to fit your process</h2>
          <p class="section__lead">
            Every team works differently. Which is why we designed our engagement models to match. Whether you need a
            scoped project, ongoing support, or something totally unique, we'll meet you where you are.
          </p>
        </div>
        <a class="button" href="/contact-us/">
          Find the right fit<span class="visually-hidden">: contact us about an engagement</span>
          <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
      <ul class="engagements" data-reveal-stagger>
        {
          engagements.map((model) => (
            <li class:list={['engagement', { 'engagement--featured': model.featured }]}>
              <div class="engagement__top">
                <span class="engagement__icon">
                  <Icon name={model.icon as 'target'} size={32} />
                </span>
                {model.featured && <p class="engagement__badge">Most popular</p>}
              </div>
              <h3>{model.title}</h3>
              <ul class="engagement__points">
                {model.points.map((point) => (
                  <li>
                    <Icon name="check" size={16} />
                    {point}
                  </li>
                ))}
              </ul>
              <p class="engagement__text">{model.text}</p>
              <a class="engagement__link" href={model.href}>
                {model.cta}
                <span class="visually-hidden"> about {model.title.toLowerCase()}</span>
                <Icon name="arrow-up-right" size={16} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="testimonials-band" aria-labelledby="testimonials-heading">
    <div class="container section">
      <div class="section__intro section__intro--center section__intro--wide">
        <p class="eyebrow">Partner <em>testimonials</em></p>
        <h2 id="testimonials-heading">Proof is better than a pitch</h2>
        <p class="section__lead">See what it's like to work with a creative team that builds for the long run.</p>
      </div>
      <div class="year-stats theme-founding" data-reveal>
        <p class="year-stats__label">2025 in numbers</p>
        <StatCards stats={yearStats} />
      </div>
      <ClientLogos />
      <Testimonials />
      <p class="section__more">
        <a class="button button--primary" href={trustpilot}>
          View all testimonials <Icon name="arrow-up-right" size={16} />
        </a>
      </p>
    </div>
  </section>

  <!-- Our work -->
  <OurWork />

  <!-- Who we are -->
  <section class="about-band curve-top" aria-labelledby="about-heading">
    <div class="container section about">
      <ul class="team" aria-label="The Founding Creative team" data-reveal-stagger>
        {
          crew.map((person) => (
            <li>
              <Img src={person.photo} alt={person.name} widths={[240, 480]} sizes="(max-width: 700px) 30vw, 180px" />
            </li>
          ))
        }
      </ul>
      <div data-reveal>
        <p class="eyebrow">Who <em>we are</em></p>
        <h2 id="about-heading">Built by creatives. Backed by strategy.</h2>
        <p class="section__lead">
          With too many businesses stuck between bloated agencies and scattered freelancers, we built the creative agency we
          always wished existed.
        </p>
        <ul class="values">
          {
            values.map((value) => (
              <li>
                <Icon name="check" size={16} />
                <span>
                  <strong>{value.title}:</strong> {value.text}
                </span>
              </li>
            ))
          }
        </ul>
        <a class="button" href="/about-us/">Meet the team <Icon name="arrow-up-right" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- Closing call to action: the live site's holographic card. It rides
       with the footer, uncovered as the page lifts away (see .page-end) -->
  <Fragment slot="page-end">
    <section class="container cta-wrap" aria-labelledby="cta-heading">
      <div class="cta" data-reveal="zoom">
        <video class="cta__video" src="/media/home/holographic.mp4" muted loop playsinline preload="none" aria-hidden="true" data-ambient
        ></video>
        <div class="cta__content">
          <div>
            <p class="cta__eyebrow">We launch websites</p>
            <h2 id="cta-heading">Your custom website starts here.</h2>
            <p class="cta__lead">Tailored web packages designed to match your goals.</p>
          </div>
          <div class="cta__actions">
            <a class="button button--dark" href="/services/website-services/">
              Find the right fit<span class="visually-hidden"> in our website services</span>
              <Icon name="arrow-up-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </section>
  </Fragment>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-height) + 4.5rem) var(--space-xl);
  }

  .hero__content {
    position: relative;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-2xs);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-bold);
    line-height: 1.5;
  }

  .hero__title {
    max-width: 10.6em;
    margin-bottom: var(--space-xs);
    font-size: var(--font-size-h1);
    font-weight: var(--font-weight-medium);
  }

  .hero__lead {
    max-width: 40rem;
    font-size: clamp(1.25rem, 1rem + 0.6vw, 1.5rem);
  }

  .hero__lead a {
    text-decoration: none;
    transition: text-shadow var(--transition-fast);
  }

  .hero__lead a:hover {
    text-shadow: var(--text-glow);
  }

  .hero__lead a:nth-of-type(1) {
    color: var(--color-holo-cyan);
  }

  .hero__lead a:nth-of-type(2) {
    color: var(--color-holo-mint);
  }

  .hero__lead a:nth-of-type(3) {
    color: var(--color-lavender);
  }

  /* First-screen proof: a still row of client logos */
  .hero__proof {
    margin-top: var(--space-lg);
  }

  .hero__clients {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero__clients img {
    width: auto;
    height: var(--logo-height);
    filter: brightness(1.7);
    opacity: 0.85;
  }

  @media (max-width: 599px) {
    .hero__clients {
      gap: var(--space-xs) var(--space-md);
    }

    .hero__clients img {
      height: calc(var(--logo-height) * 0.7);
    }
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }

  /* Services: rows split by hairlines, like the live site */
  .services {
    --curve-color: var(--color-night);
    z-index: 2;
    background-color: var(--color-night);
  }

  /* BrandForge band */
  .home-forge {
    background: linear-gradient(160deg, var(--color-forge-teal), var(--color-night));
  }

  /* The cards break out of the container to the window's width, less the
   * gutters, so the closed cards have room for their titles. */
  .home-forge__cards {
    width: min(100vw - 2 * var(--container-gutter), 110rem);
    margin-left: 50%;
    translate: -50%;
  }

  .home-forge__cta {
    margin-top: var(--space-xl);
  }

  /* "We design / We develop / We build": pinned under the header while the
   * services scroll beneath it; the verb blurs and scales between states. */
  .cycler {
    position: sticky;
    top: var(--header-height);
    z-index: 1;
    display: flex;
    gap: 0.25em;
    margin: 0;
    padding-block: var(--space-md) var(--space-lg);
    background: linear-gradient(var(--color-night) 75%, transparent);
    font-family: var(--font-display);
    font-size: clamp(3rem, 1.5rem + 4vw, 6rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: var(--tracking-display);
    line-height: 1;
  }

  .cycler__words {
    display: grid;
  }

  .cycler__word {
    grid-area: 1 / 1;
    color: var(--color-mint);
    opacity: 0;
    filter: blur(12px);
    transform: scale(0.92);
    transform-origin: left center;
    transition:
      opacity 500ms var(--ease-out),
      filter 500ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .cycler__word.is-active {
    opacity: 1;
    filter: none;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .cycler__word {
      transition: none;
    }
  }

  @media (max-width: 977px) {
    .cycler {
      display: none;
    }
  }

  .service {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr);
    gap: var(--space-2xl);
    padding-block: var(--space-xl);
    border-bottom: 1px solid var(--color-hairline);
  }

  .service__text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-lg);
  }

  .service__icon {
    display: inline-grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    margin-bottom: var(--space-lg);
    border-radius: var(--radius-md);
    background-color: var(--color-glass);
    color: var(--color-white);
  }

  .service h3 {
    margin-bottom: var(--space-3xs);
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: normal;
    line-height: 1.4;
  }

  .service__lead {
    font-size: var(--font-size-lg);
  }

  .service__body {
    color: var(--color-text-muted);
  }

  /* The service icon beats like the live site's animated icons */
  .service:hover .service__icon .icon {
    animation: heart-beat 1.3s ease-in-out;
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0 0 var(--space-sm);
    padding: 0;
    list-style: none;
  }

  /* Carousel class lands outside this page's style scope */
  .service__media :global(.service__gallery) {
    --slide-width: 15.25rem;
  }

  .service__media :global(.service__gallery) img {
    width: 100%;
    aspect-ratio: 61 / 80;
    object-fit: cover;
    border-radius: var(--radius-lg);
    pointer-events: none;
  }

  /* How we work */
  .engagement-band {
    --curve-color: var(--color-night);
    background-color: var(--color-night);
  }

  .engagements {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .engagement {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-lg);
    background-color: rgb(28 28 30 / 0.5);
    box-shadow: 0 4px 8px rgb(0 0 0 / 0.2);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast);
  }

  .engagement:hover {
    border-color: rgb(255 255 255 / 0.5);
    transform: translateY(-4px);
  }

  /* The featured model sits on the SiteLaunch conic glow */
  .engagement--featured {
