---
import { Image } from 'astro:assets';
import { getEntries } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyCard from '../../components/CaseStudyCard.astro';
import Icon from '../../components/Icon.astro';
import wave from '../../assets/brand/wave-black.svg';
import strategyLaptop from '../../assets/services/brand-strategy-laptop.webp';
import workshopLaptop from '../../assets/services/brand-workshop-laptop.webp';
import workshopNotes from '../../assets/services/brand-workshop-blue-notes.webp';

// BrandForge is the "Branding and Strategy" offering in the main menu.
const pillars = ['Research-Backed Strategy', 'Built for Humans and AI', 'Launch-Ready in Weeks'];

const audience = [
  'Founders launching a product or company and need to look legitimate from day one',
  'Startups preparing for investor outreach or a seed round',
  'Established businesses undergoing a rebrand or repositioning',
  'Teams who need a creative foundation that humans and AI tools can both run with',
  'Anyone who has outgrown their current brand and knows it',
];

const stats = [
  { value: '75%', label: 'of users judge credibility on design', source: 'https://credibility.stanford.edu/' },
  { value: '2x', label: 'the cost to tear down and rebuild a failed brand identity' },
  { value: '4', label: 'distinct strategic directions presented, not guesses' },
  { value: '100%', label: 'WCAG color compliance built into every system' },
];

const features = [
  {
    title: 'Research-Backed Strategy',
    text: 'We pressure-test your assumptions before a single mark is made. Stakeholder interviews, competitor audits, and audience personas ensure your brand is built on market reality.',
  },
  {
    title: 'Four Distinct Creative Directions',
    text: "We don't present one option and ask you to bless it. We develop four strategic directions so you can make a real decision backed by real reasoning.",
  },
  {
    title: 'Scalable Visual Identity',
    text: 'Logo systems, color strategy, and typography built to stay consistent across every screen, every asset, and every team member for years to come.',
  },
  {
    title: 'AI-Ready Brand System',
    text: 'We structure your creative foundation so every tool in your stack, from design AI to marketing automation, knows exactly what your brand is and how to use it.',
  },
  {
    title: 'Curated Activation Assets',
    text: 'From social toolkits and investor decks to packaging and web UI frameworks, we build what you need most to enter the market with confidence.',
  },
  {
    title: 'The Brand Guide',
    text: 'Your master source of truth. Delivered so your team, your partners, and your AI tools never have to guess what on-brand looks like.',
  },
];

const caseStudies = await getEntries(
  ['bell-bird-atm', 'plant-nursery-ecommerce', 'genpact-grow-event', 'safezone-product-and-branding'].map((id) => ({
    collection: 'caseStudies' as const,
    id,
  })),
);

const description =
  'BrandForge delivers research-backed brand strategy, four creative directions, and an AI-ready brand system, launch-ready in weeks, not months.';
const url = new URL('/brandforge/', Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'BrandForge',
    serviceType: 'Brand strategy and identity design',
    description,
    url,
    provider: { '@id': `${Astro.site}#organization` },
    areaServed: { '@type': 'Country', name: 'United States' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: 'BrandForge deliverables',
      itemListElement: features.map((f) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: f.title, description: f.text },
      })),
    },
  },
];
---

<BaseLayout
  title="BrandForge: Brand Strategy & Identity in Weeks | Founding Creative"
  description={description}
  ogTitle="BrandForge"
  ogImage={strategyLaptop}
  ogImageAlt="Laptop showing a brand strategy framework and color wheel"
  jsonLd={jsonLd}
>
  <section class="hero holo-bg" aria-labelledby="brandforge-title">
    <Image class="hero__wave" src={wave} alt="" loading="eager" />
    <div class="container hero__content">
      <p class="eyebrow">BrandForge™</p>
      <ul class="pillars">
        {pillars.map((pillar) => <li>{pillar}</li>)}
      </ul>
      <h1 id="brandforge-title" class="holo-text">From zero to market-ready, without the wait</h1>
      <p class="section__lead hero__lead">
        High-fidelity branding built on market reality, not founder intuition. Your identity, your systems, your flag in the
        ground.
      </p>
      <a class="button button--primary" href="#get-in-touch">Get started <Icon name="arrow-up-right" size={16} /></a>
    </div>
  </section>

  <section class="container section audience" aria-labelledby="audience-heading">
    <div>
      <p class="eyebrow">Who is <em>BrandForge</em> for</p>
      <h2 id="audience-heading">Built for brands that mean business</h2>
      <p class="section__lead">Your window to make a first impression is shorter than you think.</p>
      <ul class="audience__list">
        {
          audience.map((item) => (
            <li>
              <Icon name="check" size={18} />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <dl class="stats">
      {
        stats.map((stat) => (
          <div>
            <dt>{stat.value}</dt>
            <dd>
              {stat.label}
              {stat.source && (
                <>
                  {' '}
                  (<a href={stat.source}>source</a>)
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container section why" aria-labelledby="why-heading">
    <ul class="why__images">
      <li><Image src={strategyLaptop} alt="Laptop showing a brand strategy framework and color wheel" widths={[400, 800]} sizes="(max-width: 700px) 80vw, 360px" /></li>
      <li><Image src={workshopLaptop} alt="Laptop with a brand workshop board of green sticky notes" widths={[400, 800]} sizes="(max-width: 700px) 80vw, 360px" /></li>
      <li><Image src={workshopNotes} alt="Brand workshop board of blue sticky notes answering where the brand is going" widths={[400, 800]} sizes="(max-width: 700px) 80vw, 360px" /></li>
    </ul>
    <div class="why__text">
      <p class="eyebrow">Why <em>BrandForge?</em></p>
      <h2 id="why-heading">Low-cost design is the most expensive thing you can buy</h2>
      <p class="section__lead">Most startups die in the gap between ambition and execution.</p>
      <p>
        Traditional agencies are too slow and too expensive. In-house teams are too narrow. BrandForge is the third option:
        high-fidelity branding and a launch-ready creative system delivered in weeks, not months. Built on research. Built
        to last.
      </p>
    </div>
  </section>

  <section class="container section" aria-labelledby="features-heading">
    <div class="section__intro">
      <p class="eyebrow">BrandForge <em>features</em></p>
      <h2 id="features-heading">A brand only humans can use is half a brand</h2>
      <p class="section__lead">
        BrandForge is built for brands that need to move fast without cutting corners. Every deliverable is crafted to give
        your team and your tools a shared creative language. From logo systems to AI-ready design kits, this is the
        foundation your business will build on for years.
      </p>
      <p>Your brand is the source of truth. We build it right the first time.</p>
    </div>
    <ol class="features">
      {
        features.map((feature) => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.text}</p>
          </li>
        ))
      }
    </ol>
    <p class="section__more">
      <a class="button button--primary" href="#get-in-touch">Get started <Icon name="arrow-up-right" size={16} /></a>
    </p>
  </section>

  <section class="container section" aria-labelledby="work-heading">
    <div class="section__intro section__intro--split">
      <div>
        <p class="eyebrow">Our <em>work</em></p>
        <h2 id="work-heading">From vision to victory</h2>
        <p class="section__lead">
          A look inside the branding projects where strategy, structure, and design all came together to drive meaningful
          business outcomes.
        </p>
      </div>
      <a class="button" href="/case-studies/">All case studies <Icon name="arrow-up-right" size={16} /></a>
    </div>
    <div class="card-grid">
      {caseStudies.map((study) => <CaseStudyCard study={study} headingLevel={3} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .hero__wave {
    position: absolute;
    z-index: -1;
    inset: auto 0 0 auto;
    width: 70%;
    max-width: 60rem;
    opacity: 0.6;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
  }

  .hero h1 {
    max-width: 16ch;
  }

  .hero__lead {
    max-width: 36rem;
    color: var(--color-text);
  }

  .pillars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0 0 var(--space-md);
    padding: 0;
    list-style: none;
  }

  .pillars li {
    padding: 2px var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: rgb(0 0 0 / 0.4);
    font-size: var(--font-size-sm);
  }

  .audience {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-xl);
    align-items: center;
  }

  .audience__list {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .audience__list li {
    display: flex;
    gap: var(--space-2xs);
  }

  .audience__list .icon {
    margin-top: 0.3em;
    color: var(--color-mint);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md);
    margin: 0;
  }

  .stats div {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
  }

  .stats dt {
    color: var(--color-mint);
    font-family: var(--font-display);
    font-size: var(--font-size-h2);
    line-height: 1;
  }

  .stats dd {
    margin: var(--space-2xs) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .why {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr));
    gap: var(--space-xl);
    align-items: center;
  }

  .why__images {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .why__images img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }

  .why__text p:last-child {
    color: var(--color-text-muted);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: feature;
  }

  .features li {
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    counter-increment: feature;
  }

  .features li::before {
    content: counter(feature, decimal-leading-zero);
    color: var(--color-mint);
    font-weight: var(--font-weight-bold);
  }

  .features h3 {
    margin-top: var(--space-2xs);
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-semibold);
  }

  .features p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-md);
  }
</style>
