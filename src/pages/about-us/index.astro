---
import Img from '../../components/Img.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaSection from '../../components/CtaSection.astro';
import StatCards from '../../components/StatCards.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import Icon from '../../components/Icon.astro';
import { team } from '../../data/team';
import { testimonials } from '../../data/testimonials';
import { pages } from '../../data/seo';
import LineArt from '../../components/LineArt.astro';
import HeroBackdrop from '../../components/HeroBackdrop.astro';
import builderSvg from '../../assets/pages/about-builder-illustration.svg?raw';

const people = team();

const values = [
  { title: 'Clarity over chaos', text: 'Solutions rooted in structure and strategy' },
  { title: 'Relationships first', text: 'We work with people, not logos' },
  { title: 'Creative systems', text: 'Always building together to drive outcomes' },
  { title: 'Founding energy', text: 'Every project is a chance for something big' },
];

const engagements = [
  {
    title: 'Fixed projects',
    icon: 'target',
    points: ['Clear scope', 'Defined timelines', 'Focused engagement'],
    text: 'Straightforward path from idea to launch through clearly defined scopes.',
    href: '/contact-us/',
    cta: "Let's talk",
  },
  {
    title: 'Fractional creative',
    icon: 'layers',
    featured: true,
    points: ['Priority access', 'Multiple work streams', 'Sliding scale cost'],
    text: 'Designed to reduce expenses for teams in need of regular creative support.',
    href: '/fractional-creative/',
    cta: 'Learn more',
  },
  {
    title: 'Custom fit',
    icon: 'puzzle',
    points: ['Creative ops guidance', 'Adapted to your systems', 'Built around your org'],
    text: 'Co-create the right structure for your unique goals, constraints, and vision.',
    href: '/contact-us/',
    cta: "Let's talk",
  },
];

// 2025 in numbers, above the client words.
const yearStats = [
  { value: '28', label: 'clients' },
  { value: '800+', label: 'tasks delivered' },
  { value: '3,000+', label: 'hours of creative' },
  { value: '73%', label: 'of proposals won' },
];

const { description } = pages['/about-us/'];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Founding Creative',
  description,
  url: new URL('/about-us/', Astro.site).href,
  mainEntity: {
    '@id': `${Astro.site}#organization`,
    employee: people.map((person) => ({
      '@type': 'Person',
      name: person.name,
      jobTitle: person.role,
      sameAs: person.linkedin,
    })),
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  <!-- Hero: the homepage's four-color gradient under the wave and a dark veil -->
  <section class="about-hero under-header" aria-labelledby="about-title">
    <HeroBackdrop />
    <div class="container">
      <div class="about-hero__head" data-intro>
        <h1 id="about-title">About us</h1>
        <p class="about-hero__lead">Sustainable growth begins with a solid foundation.</p>
      </div>
      <div class="about-hero__grid">
        <div data-intro="left">
          <p class="about-hero__intro">
            Brought together from a desire to offer up the missing middle ground. A ground where holistic creative strategies
            are developed not just as one-offs, but as one-mores.
          </p>
          <p class="about-hero__statement">
            Every initiative is one more step towards foundational creative systems that scale with your business.
          </p>
        </div>
        <LineArt svg={builderSvg} mode="draw" class="about-hero__builder" />
      </div>
    </div>
  </section>

  <!-- White band: the team, what we stand for, and who we've worked with -->
  <div class="about-light curve-top curve-bottom">
    <!-- Our story, with "The Founding difference" from the Creative GTM deck -->
    <section class="container section story" aria-labelledby="story-heading">
      <div class="story__text" data-reveal>
        <p class="eyebrow">Our <em>story</em></p>
        <h2 id="story-heading">The missing middle ground</h2>
        <p class="section__lead">
          Josh Titus and Tyler Lukey started Founding Creative in 2024 for the teams stuck between bloated agencies and
          scattered freelancers. We work from Denver and Chattanooga with clients across the US.
        </p>
        <p>
          You work with the founders directly. No layers of account executives, producers, and art directors between your
          idea and the people making it, so more of every hour goes into the work.
        </p>
      </div>
      <figure class="story__split" data-reveal>
        <figcaption class="story__caption">More creative. Less management.</figcaption>
        <dl class="split-bars">
          <div class="split-bar split-bar--ours">
            <dt>Founding Creative</dt>
            <dd>
              <span class="split-bar__creative" style="--share: 90%">90% creative</span>
              <span class="split-bar__management" style="--share: 10%">10% management</span>
            </dd>
          </div>
          <div class="split-bar">
            <dt>Traditional agency</dt>
            <dd>
              <span class="split-bar__creative" style="--share: 33%">33% creative</span>
              <span class="split-bar__management" style="--share: 67%">66% management</span>
            </dd>
          </div>
        </dl>
      </figure>
    </section>

    <section class="container section" aria-labelledby="team-heading">
      <div class="section__intro about-light__intro">
        <p class="eyebrow">Our <em>team</em></p>
        <h2 id="team-heading">Built by creatives. Backed by strategy.</h2>
        <p class="section__lead">
          With too many businesses stuck between bloated agencies and scattered freelancers, we built the creative agency we
          always wished existed.
        </p>
      </div>
      <ul class="team" data-reveal-stagger>
        {
          people.map((person) => (
            <li class="person">
              <div class="person__photo">
                <Img
                  src={person.photo}
                  alt={`${person.name}, ${person.role}`}
                  widths={[320, 640]}
                  sizes="(max-width: 600px) 80vw, 300px"
                />
                <a class="person__linkedin" href={person.linkedin}>
                  <Icon name="linkedin" size={20} />
                  <span class="visually-hidden">{person.name} on LinkedIn</span>
                </a>
              </div>
              <h3>{person.name}</h3>
              <p>{person.role}</p>
              {person.bio && <p class="person__bio">{person.bio}</p>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="container section values-section" aria-labelledby="values-heading">
      <h2 id="values-heading" class="values__heading" data-reveal>What we stand for</h2>
      <dl class="values" data-reveal-stagger>
        {
          values.map((value, i) => (
            <div class="value">
              <span class="value__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <dt>{value.title}</dt>
              <dd>{value.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- How we work: the three engagement models (moved here from the homepage) -->
    <section class="engagement-band" aria-labelledby="engagement-heading">
      <div class="container section">
        <div class="section__intro section__intro--split">
          <div>
            <p class="eyebrow">How we <em>work</em></p>
            <h2 id="engagement-heading">Built to fit your process</h2>
            <p class="section__lead">
              Every team works differently. Which is why we designed our engagement models to match. Whether you need a
              scoped project, ongoing support, or something totally unique, we'll meet you where you are.
            </p>
          </div>
          <a class="button button--dark" href="/contact-us/">
            Find the right fit<span class="visually-hidden">: contact us about an engagement</span>
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
        <ul class="engagements" data-reveal-stagger>
          {
            engagements.map((model) => (
              <li class:list={['engagement', { 'engagement--featured': model.featured }]}>
                <div class="engagement__top">
                  <span class="engagement__icon">
                    <Icon name={model.icon as 'target'} size={32} />
                  </span>
                  {model.featured && <p class="engagement__badge">Most popular</p>}
                </div>
                <h3>{model.title}</h3>
                <ul class="engagement__points">
                  {model.points.map((point) => (
                    <li>
                      <Icon name="check" size={16} />
                      {point}
                    </li>
                  ))}
                </ul>
                <p class="engagement__text">{model.text}</p>
                <a class="engagement__link" href={model.href}>
                  {model.cta}
                  <span class="visually-hidden"> about {model.title.toLowerCase()}</span>
                  <Icon name="arrow-up-right" size={16} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- 2025 in numbers (moved here from the homepage), as light cards -->
    <section class="container section year-stats" aria-labelledby="year-stats-heading" data-reveal>
      <h2 id="year-stats-heading" class="year-stats__label">2025 in numbers</h2>
      <StatCards stats={yearStats} />
    </section>

    <!-- Client words, from the old WordPress testimonial pages -->
    <section class="container section" aria-labelledby="testimonials-heading">
      <div class="section__intro about-light__intro" data-reveal>
        <p class="eyebrow">Client <em>words</em></p>
        <h2 id="testimonials-heading">What working with us is like</h2>
      </div>
      <ul class="quotes" data-reveal-stagger>
        {
          testimonials.map((t) => (
            <li class="quote">
              <figure>
                <blockquote>
                  <p>“{t.quote}”</p>
                </blockquote>
                <figcaption>
                  <strong>{t.name}</strong>
                  <span>
                    {t.role}, {t.company}
                  </span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-light__logos" aria-label="Brands we've worked with">
      <ClientLogos />
    </section>
  </div>

  <CtaSection heading="Let's build your foundation" text="Tell us where you're headed and we'll help you get there." />
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .about-hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-height) + 4rem) var(--space-2xl);
  }

  .about-hero__head {
    margin-bottom: var(--space-2xl);
    text-align: center;
  }

  .about-hero h1 {
    margin-bottom: var(--space-sm);
    text-shadow: var(--text-glow);
  }

  .about-hero__lead {
    margin: 0;
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-semibold);
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
  }

  .about-hero__intro {
    margin-bottom: var(--space-lg);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
  }

  .about-hero__statement {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-h4);
    letter-spacing: var(--tracking-display);
    line-height: var(--line-height-snug);
    text-wrap: balance;
  }

  .about-hero :global(.about-hero__builder) {
    justify-self: center;
    width: min(100%, 25rem);
  }

  /* ===== White band ===== */
  .about-light {
    --curve-color: var(--color-white);
    background-color: var(--color-white);
    color: var(--color-night);
  }

  .about-light__intro {
    margin-inline: auto;
    text-align: center;
  }

  .about-light .section__lead {
    margin-inline: auto;
    color: var(--color-neutral-dark);
  }

  /* The white eyebrow and its pearl accent word vanish on white, so here
   * they go ink with a deep mint accent */
  .about-light .eyebrow {
    color: var(--color-night);
  }

  .about-light .eyebrow :global(em) {
    background: none;
    -webkit-text-fill-color: currentColor;
    color: var(--color-mint-darker);
    text-shadow: none;
  }

  .team {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2xl) var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .person__photo {
    position: relative;
    max-width: 18.75rem;
    margin-inline: auto;
  }

  .person__photo img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-2xl);
    transition:
      transform 600ms var(--ease-out),
      box-shadow 600ms var(--ease-out);
  }

  .person:hover .person__photo img {
    box-shadow: 0 1.5rem 3rem rgb(0 4 7 / 0.18);
    transform: translateY(-4px);
  }

  /* The LinkedIn tab notched into the photo's corner, as on the live page.
   * The two small curves either side make the white flow into the cut. */
  .person__linkedin {
    position: absolute;
    top: 0;
    right: 0;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-bottom-left-radius: var(--radius-lg);
    background-color: var(--color-white);
    color: var(--color-neutral);
    transition: color var(--transition-fast);
  }

  .person__linkedin::before,
  .person__linkedin::after {
    content: '';
    position: absolute;
    width: var(--radius-lg);
    height: var(--radius-lg);
    background: radial-gradient(circle at 0 100%, transparent var(--radius-lg), var(--color-white) calc(var(--radius-lg) + 0.5px));
  }

  .person__linkedin::before {
    top: 0;
    right: 100%;
  }

  .person__linkedin::after {
    top: 100%;
    right: 0;
  }

  .person__linkedin:hover {
    color: var(--color-night);
  }

  .person h3 {
    margin: var(--space-md) 0 var(--space-3xs);
    color: var(--color-night);
    font-size: var(--font-size-h4);
    font-weight: var(--font-weight-regular);
  }

  .person p {
    margin: 0;
    color: var(--color-neutral-dark);
  }

  /* What we stand for: four numbered columns on hairlines */
  /* Our story: text beside the creative / management split */
  .story {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    align-items: center;
  }

  .story__split {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid rgb(0 4 7 / 0.12);
    border-radius: var(--radius-lg);
  }

  .story__caption {
    margin-bottom: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--font-size-h4);
  }

  .split-bars {
    display: grid;
    gap: var(--space-md);
    margin: 0;
  }

  .split-bar dt {
    margin-bottom: var(--space-3xs);
    font-weight: var(--font-weight-semibold);
  }

  .split-bar dd {
    display: flex;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-pill);
    font-size: var(--font-size-sm);
    white-space: nowrap;
  }

  .split-bar dd span {
    flex: 0 0 var(--share);
    min-width: 0;
    padding: var(--space-2xs) var(--space-sm);
    overflow: hidden;
    text-overflow: clip;
  }

  .split-bar__creative {
    background-color: var(--color-mint-darker);
    color: var(--color-white);
  }

  .split-bar__management {
    background-color: rgb(0 4 7 / 0.08);
    color: var(--color-night);
  }

  .split-bar--ours .split-bar__creative {
    background-color: var(--color-mint);
    color: var(--color-night);
  }

  /* 10% is too narrow for its label; the caption carries it */
  .split-bar--ours .split-bar__management {
    font-size: 0;
  }

  .person__bio {
    margin-top: var(--space-2xs);
    font-size: var(--font-size-sm);
    opacity: 0.8;
  }

  /* ===== How we work: three engagement models, as light cards ===== */
  .engagement-band .section__intro--split .section__lead {
    margin-inline: 0;
  }

  .engagements {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .engagement {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    border: 1px solid rgb(0 4 7 / 0.12);
    border-radius: var(--radius-lg);
    background-color: rgb(0 4 7 / 0.03);
    transition:
      transform var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .engagement:hover {
    border-color: rgb(0 4 7 / 0.3);
    box-shadow: 0 1.5rem 3rem rgb(0 4 7 / 0.12);
    transform: translateY(-4px);
  }

  /* The featured model is outlined in ink over a soft mint wash */
  .engagement--featured {
    border-color: var(--color-night);
    background: linear-gradient(160deg, var(--color-mint-pale), var(--color-white) 70%);
  }

  .engagement__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-sm);
  }

  .engagement__icon {
    display: inline-grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-md);
    background-color: rgb(0 4 7 / 0.06);
  }

  .engagement--featured .engagement__icon {
    background-color: var(--color-white);
  }

  .engagement__badge {
    margin: 0;
    padding: 2px var(--space-xs);
    border-radius: var(--radius-pill);
    background: var(--color-night);
    color: var(--color-white);
    font-size: 0.8rem;
    font-weight: var(--font-weight-semibold);
  }

  .engagement h3 {
    margin: 0;
    color: var(--color-night);
    font-family: var(--font-body);
    font-size: 1.6rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: normal;
  }

  .engagement__points {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
  }

  .engagement__points li {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .engagement__text {
    flex: 1;
    margin: 0;
    color: var(--color-neutral-dark);
    font-size: 0.9rem;
  }

  .engagement__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
    color: var(--color-night);
    font-weight: var(--font-weight-semibold);
    text-decoration: none;
  }

  .engagement__link:hover {
    color: var(--color-mint-darker);
  }

  .engagement__link .icon {
    transition: transform var(--transition-fast);
  }

  .engagement__link:hover .icon {
    transform: translate(2px, -2px);
  }

  /* ===== 2025 in numbers: the stat cards, relit for white ===== */
  .year-stats {
    --accent: var(--color-mint-darker);
    padding-block: 0;
  }

  .year-stats__label {
    margin: 0 0 var(--space-sm);
    color: var(--color-neutral-dark);
    font-family: var(--font-body);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    letter-spacing: normal;
    text-align: center;
  }

  .year-stats :global(.stats) {
    grid-template-columns: repeat(4, 1fr);
  }

  .year-stats :global(.stat) {
    border-color: rgb(0 4 7 / 0.12);
    background-color: rgb(0 4 7 / 0.03);
    backdrop-filter: none;
  }

  .year-stats :global(.stat:hover) {
    border-color: rgb(0 4 7 / 0.3);
  }

  .year-stats :global(.stat__value) {
    text-shadow: none;
  }

  @media (max-width: 977px) {
    .year-stats :global(.stats) {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* Client quotes: a masonry-ish set of cards */
  .quotes {
    columns: 3 18rem;
    column-gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quote {
    break-inside: avoid;
    margin-bottom: var(--space-md);
  }

  .quote figure {
    margin: 0;
    padding: var(--space-lg);
    border: 1px solid rgb(0 4 7 / 0.12);
    border-radius: var(--radius-lg);
    background-color: rgb(0 4 7 / 0.03);
  }

  .quote blockquote {
    margin: 0 0 var(--space-md);
  }

  .quote figcaption {
    display: grid;
    font-size: var(--font-size-sm);
  }

  .quote figcaption span {
    opacity: 0.8;
  }

  @media (max-width: 977px) {
    .story {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .values-section {
    padding-top: 0;
  }

  .values__heading {
    margin-bottom: var(--space-lg);
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-regular);
  }

  .values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    margin: 0;
  }

  .value {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-neutral-lighter);
  }

  .value__index {
    display: block;
    margin-bottom: var(--space-sm);
    color: var(--color-neutral);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    letter-spacing: 0.1em;
  }

  .value dt {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--font-size-h6);
    line-height: var(--line-height-heading);
  }

  .value dd {
    margin: 0;
    color: var(--color-neutral-dark);
  }

  /* The gray logos sit on white as they do on the live service pages */
  .about-light__logos {
    padding-bottom: var(--space-2xl);
  }

  .about-light__logos :global(.clients img) {
    filter: none;
  }

  .about-light__logos :global(.clients__toggle) {
    border-color: var(--color-neutral-lighter);
    background-color: var(--color-white);
    color: var(--color-neutral-dark);
  }

  /* ===== Small screens ===== */
  @media (max-width: 977px) {
    .about-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .team {
      grid-template-columns: repeat(2, 1fr);
    }

    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .team,
    .values {
      grid-template-columns: 1fr;
    }
  }
</style>
