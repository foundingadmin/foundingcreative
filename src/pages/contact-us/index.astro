---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';

// Title and OG title match the WordPress crawl. The live meta description is
// broken plugin text ("Please enable JavaScript..."), so it is rewritten here.
---

<BaseLayout
  title="Contact Us - Founding Creative"
  description="Tell us about your brand, website, or creative project. Send Founding Creative a message and we'll get back to you soon."
  ogTitle="Contact Us"
>
  <section class="container contact">
    <p class="contact__eyebrow">We are here to hear</p>
    <h1>Send us a message.</h1>
    <ContactForm variant="full" />
  </section>
</BaseLayout>

<style>
  .contact {
    max-width: 720px;
    padding-block: var(--space-3xl);
  }

  .contact__eyebrow {
    color: var(--color-text-muted);
    font-size: var(--font-size-md);
  }
</style>
