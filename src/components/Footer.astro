---
// Placeholder footer. Remaining legal links (Cookie Policy, Privacy
// Statement) get added once their WordPress slugs are confirmed.
const year = new Date().getFullYear();

const legal = [
  { href: '/imprint/', label: 'Imprint' },
  { href: '/disclaimer/', label: 'Disclaimer' },
];
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p class="site-footer__copy">&copy; {year} Founding Creative</p>
    <nav aria-label="Legal">
      <ul class="site-footer__nav">
        {
          legal.map(({ href, label }) => (
            <li>
              <a href={href}>{label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-lg);
  }

  .site-footer__copy {
    margin: 0;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__nav a {
    color: var(--color-text-muted);
  }

  .site-footer__nav a:hover {
    color: var(--color-link);
  }
</style>
