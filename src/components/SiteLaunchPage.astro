---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import PillarPills from './PillarPills.astro';
import CheckList from './CheckList.astro';
import StatCards from './StatCards.astro';
import FeatureGrid from './FeatureGrid.astro';
import ProcessTimeline from './ProcessTimeline.astro';
import SiteLaunchPackages from './SiteLaunchPackages.astro';
import TeamFaces from './TeamFaces.astro';
import Icon from './Icon.astro';
import ContactForm from './ContactForm.astro';
import prismArt from '../assets/home/sitelaunch/flare-1.png';
import rocketArt from '../assets/home/sitelaunch/rocket-1.png';
import orbitArt from '../assets/home/sitelaunch/orbit-1.png';
import { siteLaunchBookingHref } from '../data/navigation';

// One template for the three SiteLaunch package pages, laid out as on the
// live pages and built from the same pieces as BrandForge: the package's
// photo hero, then one backdrop in the package's colors under the audience
// and stats, why, features, the process timeline, the inquiry form, and the
// other packages. The theme-* class sets every color.

interface Props {
  /** Entry in the sitelaunch collection: prism, rocket, or orbit. */
  id: 'prism' | 'rocket' | 'orbit';
}

const { id } = Astro.props;
const entry = await getEntry('sitelaunch', id);
if (!entry) throw new Error(`Unknown SiteLaunch package: ${id}`);
const { data } = entry;
const packageName = `${data.name} SiteLaunch`;
const path = `/${id}-sitelaunch/`;
const art = { prism: prismArt, rocket: rocketArt, orbit: orbitArt }[id];

const nextSteps = [
  'Submissions reviewed within 2 to 3 business days',
  "We'll email you a link to schedule a call",
  "You'll meet directly with our founders",
  "Together, we'll map a path forward that converts",
];

const url = new URL(path, Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: `${packageName}™`,
    serviceType: 'Website design and development',
    description: data.description,
    url,
    provider: { '@id': `${Astro.site}#organization` },
    areaServed: { '@type': 'Country', name: 'United States' },
    hasOfferCatalog: {
      '@type': 'OfferCatalog',
      name: `${packageName} features`,
      itemListElement: data.features.items.map((f) => ({
        '@type': 'Offer',
        itemOffered: { '@type': 'Service', name: f.title, description: f.text },
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Website Services',
        item: new URL('/services/website-services/', Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: packageName, item: url },
    ],
  },
];
---

<BaseLayout
  title={data.seoTitle}
  description={data.description}
  ogTitle={data.ogTitle}
  ogDescription={data.ogDescription}
  ogImage={data.shareImage}
  ogImageAlt={data.shareImageAlt}
  jsonLd={jsonLd}
>
  <div class:list={['sl', `theme-${id}`]}>
    <!-- Hero: the package's photo under the night veil -->
    <section class="sl-hero under-header" aria-labelledby="sitelaunch-title">
      <HeroBackdrop variant="image" image={data.heroImage} />
      <div class="container" data-intro>
        <p class="sl-hero__eyebrow"><span class="accent">{data.name}</span> SiteLaunch™</p>
        <PillarPills pillars={data.pillars} />
        <h1 id="sitelaunch-title">{data.title}</h1>
        <p class="tone-lead sl-hero__subtitle">{data.subtitle}</p>
        <div class="sl-actions">
          <a class="button button--tone" href="#get-started">Get started <Icon name="arrow-right" size={16} /></a>
          <a class="button" href={siteLaunchBookingHref}>Book a meeting</a>
        </div>
      </div>
    </section>

    <div class="tone-backdrop">
      <!-- Who it's for, beside the stats -->
      <section aria-labelledby="audience-heading">
        <div class="container section sl-split">
          <div data-reveal="left">
            <p class="tone-kicker">Who is <span class="accent">{data.name}</span> SiteLaunch for?</p>
            <h2 id="audience-heading">{data.audience.heading}</h2>
            <p class="tone-lead">{data.audience.lead}</p>
            <CheckList items={data.audience.points} />
          </div>
          <StatCards stats={data.stats} />
        </div>
      </section>

      <!-- Why: the package's art floating beside the argument -->
      <section aria-labelledby="why-heading">
        <div class="container section sl-split">
          <div class="sl-art" aria-hidden="true">
            <Image src={art} alt="" widths={[480, 960]} sizes="(max-width: 977px) 80vw, 520px" />
          </div>
          <div data-reveal="right">
            <p class="tone-kicker">Why <span class="accent">{data.name}</span> SiteLaunch?</p>
            <h2 id="why-heading">{data.why.heading}</h2>
            <p class="tone-lead">{data.why.lead}</p>
            <p class="tone-copy">{data.why.text}</p>
          </div>
        </div>
      </section>

      <FeatureGrid labelledby="features-heading" items={data.features.items}>
        <p class="tone-kicker"><span class="accent">{data.name}</span> SiteLaunch features</p>
        <h2 id="features-heading">{data.features.heading}</h2>
        <p class="tone-copy">{data.features.text}</p>
        <p class="tone-lead">{data.features.lead}</p>
        <a class="button button--tone" href="#get-started">Get started <Icon name="arrow-right" size={16} /></a>
      </FeatureGrid>

      <!-- Process: the pitch and a booking card beside the timeline -->
      <section aria-labelledby="process-heading">
        <div class="container section sl-process">
          <div class="sl-process__intro">
            <p class="tone-kicker"><span class="accent">{data.name}</span> SiteLaunch process</p>
            <h2 id="process-heading">{data.process.heading}</h2>
            <p class="tone-copy">{data.process.text}</p>
            <p class="tone-lead">{data.process.lead}</p>
            <div class="sl-glass sl-booking">
              <h3>Tell us about your needs</h3>
              <p>
                Book a <span class="accent">free discovery meeting</span> to learn how we can help turn your site into a
                numbers machine with {packageName}™.
              </p>
              <a class="button button--tone" href={siteLaunchBookingHref}>
                Book a meeting <Icon name="arrow-up-right" size={16} />
              </a>
            </div>
          </div>
          <ProcessTimeline steps={data.process.steps} />
        </div>
      </section>

      <!-- Closing statement -->
      <section class="container section sl-closing" aria-labelledby="closing-heading" data-reveal>
        <h2 id="closing-heading">{data.closing.heading}</h2>
        <p class="tone-copy">{data.closing.text}</p>
        <p class="tone-lead accent">{data.closing.tagline}</p>
      </section>

      <!-- Get started: the pitch and team beside the inquiry form -->
      <section id="get-started" aria-labelledby="cta-heading">
        <div class="container section sl-split sl-split--top">
          <div data-reveal="left">
            <p class="sl-cta__eyebrow"><span class="accent">{data.name}</span> SiteLaunch™</p>
            <h2 id="cta-heading">{data.ctaHeading}</h2>
            <p class="tone-copy">
              Tell us a little about your brand and your goals. We'll review your details and reach out to schedule a
              discovery call. No pressure, no hard sells. Just a conversation about building a digital presence as bold as
              your ambitions.
            </p>
            <CheckList items={nextSteps} />
            <TeamFaces class="sl-cta__faces" size={4} />
          </div>
          <div class="sl-glass sl-inquiry" data-reveal="right">
            <h3 class="sl-inquiry__heading">Tell us about your brand and your goals</h3>
            <ContactForm variant="sitelaunch" sitelaunchPackage={data.name as 'Prism' | 'Rocket' | 'Orbit'} idPrefix="sitelaunch" />
            <p class="sl-inquiry__note">
              Submitting this form does not guarantee acceptance into the SiteLaunch™ program. All inquiries are reviewed for
              fit with our services, process, and scheduling availability.
            </p>
          </div>
        </div>
      </section>

      <!-- The other packages -->
      <section aria-labelledby="others-heading">
        <div class="container section">
          <div class="section__intro section__intro--center">
            <h2 id="others-heading">Find the right launch for your next move</h2>
            <p class="section__lead">
              Not sure if this SiteLaunch™ is the right fit? Explore our other options tailored for different goals,
              audiences, and growth stages.
            </p>
          </div>
          <SiteLaunchPackages current={id} />
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  /* ===== Hero ===== */
  .sl-hero {
    position: relative;
    overflow: hidden;
    padding-block: calc(var(--header-height) + 4.5rem) var(--space-3xl);
  }

  .sl-hero__eyebrow,
  .sl-cta__eyebrow {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-eyebrow);
    font-weight: var(--font-weight-bold);
    line-height: 1.5;
  }

  .sl-hero h1 {
    max-width: 11em;
    margin-bottom: var(--space-md);
    text-shadow: var(--text-glow);
  }

  .sl-hero__subtitle {
    max-width: 34rem;
  }

  .sl-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  /* ===== Two-column sections ===== */
  .sl-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-2xl);
  }

  .sl-split--top {
    align-items: start;
  }

  /* The package's art, floating in a glow of its own color */
  .sl-art {
    position: relative;
    isolation: isolate;
    justify-self: center;
    width: min(100%, 30rem);
  }

  .sl-art::before {
    content: '';
    position: absolute;
    inset: 15%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(color-mix(in srgb, var(--accent) 45%, transparent), transparent 70%);
    filter: blur(30px);
  }

  .sl-art img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sl-art img {
      animation: sl-float 7s ease-in-out infinite;
    }

    .sl-art::before {
      animation: sl-glow 7s ease-in-out infinite;
    }
  }

  @keyframes sl-float {
    50% {
      transform: translateY(-14px) rotate(-2deg);
    }
  }

  @keyframes sl-glow {
    50% {
      opacity: 0.6;
      transform: scale(0.92);
    }
  }

  /* Frosted cards: the booking card and the inquiry form */
  .sl-glass {
    padding: var(--space-lg);
    border: 1px solid rgb(255 255 255 / 0.2);
    border-radius: var(--radius-lg);
    background-color: rgb(28 28 30 / 0.5);
    box-shadow: 0 4px 8px rgb(0 0 0 / 0.2);
    backdrop-filter: blur(10px);
  }

  /* ===== Process ===== */
  .sl-process {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: var(--space-2xl);
  }

  .sl-process__intro {
    position: sticky;
    top: calc(var(--header-height) + var(--space-lg));
  }

  .sl-booking {
    margin-top: var(--space-lg);
  }

  .sl-booking h3,
  .sl-inquiry__heading {
    margin-bottom: var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-regular);
    letter-spacing: normal;
  }

  .sl-booking p {
    margin-bottom: var(--space-lg);
  }

  /* ===== Closing ===== */
  .sl-closing {
    max-width: calc(48rem + 2 * var(--container-gutter));
    text-align: center;
  }

  .sl-closing h2 {
    max-width: 12em;
    margin-inline: auto;
  }

  /* ===== Get started ===== */
  .sl-split :global(.checks) {
    margin-top: var(--space-lg);
  }

  .sl-split :global(.sl-cta__faces) {
    --ring: var(--color-white);
    margin-top: var(--space-xl);
  }

  .sl-inquiry__note {
    margin: var(--space-md) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  /* ===== Small screens ===== */
  @media (max-width: 977px) {
    .sl-split,
    .sl-process {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .sl-process__intro {
      position: static;
    }
  }
</style>
