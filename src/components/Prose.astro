---
// Wraps rendered Markdown. Light, like the article area on the live site.
// The "article" variant is the Field Notes reading size from the live posts:
// a 900px column of 22.4px copy with Gelica section heads.

interface Props {
  variant?: 'default' | 'article';
}

const { variant = 'default' } = Astro.props;
---

<div class:list={['prose', { 'prose--article': variant === 'article' }]}><slot /></div>

<style>
  .prose {
    max-width: 46rem;
    margin-inline: auto;
    color: var(--color-neutral-darker);
    font-size: var(--font-size-base);
    line-height: 1.7;
  }

  .prose :global(> * + *) {
    margin-top: var(--space-md);
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: 0;
  }

  .prose :global(h2),
  .prose :global(h3),
  .prose :global(h4) {
    margin-top: var(--space-xl);
    margin-bottom: 0;
    color: var(--color-black);
  }

  .prose :global(h2) {
    font-size: var(--font-size-h4);
  }

  .prose :global(h3) {
    font-size: var(--font-size-h5);
  }

  .prose :global(h4) {
    font-size: var(--font-size-h6);
  }

  .prose :global(h2 strong) {
    color: var(--color-mint-darker);
  }

  .prose :global(a) {
    color: var(--color-mint-darker);
    font-weight: var(--font-weight-semibold);
  }

  .prose :global(a:hover) {
    color: var(--color-black);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.4em;
  }

  .prose :global(li + li) {
    margin-top: var(--space-2xs);
  }

  .prose :global(li::marker) {
    color: var(--color-mint-dark);
    font-weight: var(--font-weight-bold);
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: var(--space-sm) var(--space-md);
    border-left: 4px solid var(--color-mint);
    background-color: var(--color-mint-lighter);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-family: var(--font-display);
    font-size: var(--font-size-lg);
  }

  .prose :global(hr) {
    margin-block: var(--space-xl);
    border: 0;
    border-top: 1px solid var(--color-neutral-lighter);
  }

  .prose :global(img),
  .prose :global(video) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-size-sm);
  }

  .prose :global(th),
  .prose :global(td) {
    padding: var(--space-2xs) var(--space-xs);
    border: 1px solid var(--color-neutral-lighter);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    background-color: var(--color-neutral-lightest);
  }

  /* Tinted sections, from WordPress group blocks with a background */
  .prose :global(.callout) {
    padding: var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-mint-lighter), var(--color-white) 70%);
    border: 1px solid var(--color-neutral-lighter);
  }

  .prose :global(.callout > :first-child) {
    margin-top: 0;
  }

  .prose :global(.callout > * + *) {
    margin-top: var(--space-sm);
  }

  /* White line art (diagrams, logos) made for dark sections */
  .prose :global(.on-dark) {
    padding: var(--space-lg);
    border-radius: var(--radius-md);
    background-color: var(--color-black);
  }

  .prose :global(.on-dark img) {
    border-radius: 0;
  }

  .prose :global(:focus-visible) {
    outline-color: var(--color-black);
  }

  /* ===== Field Notes article ===== */
  .prose--article {
    max-width: 56.25rem;
    color: var(--color-night);
    font-size: var(--font-size-article);
    font-weight: var(--font-weight-regular);
  }

  .prose--article :global(> * + *) {
    margin-top: 1.3em;
  }

  .prose--article :global(h2),
  .prose--article :global(h3),
  .prose--article :global(h4) {
    margin-top: 2.6em;
    color: var(--color-night);
    font-weight: var(--font-weight-regular);
    text-wrap: balance;
    /* Clear the sticky header when jumped to from the contents */
    scroll-margin-top: calc(var(--header-height) + var(--space-lg));
  }

  .prose--article :global(h2) {
    font-size: var(--font-size-h3);
    line-height: 1;
  }

  .prose--article :global(h3) {
    font-size: var(--font-size-h5);
    line-height: var(--line-height-heading);
  }

  .prose--article :global(h4) {
    font-family: var(--font-body);
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    letter-spacing: normal;
  }

  .prose--article :global(:is(h2, h3, h4) + *) {
    margin-top: 0.8em;
  }

  /* The live pull quote: big Manrope set in from a holographic rule */
  .prose--article :global(blockquote) {
    margin-block: 2em;
    padding: 0.2em 0 0.2em 1.5em;
    border: 0;
    border-radius: 0;
    background: linear-gradient(var(--color-cyan), var(--color-mint-pale), var(--color-lavender-light)) left / 3px 100%
      no-repeat;
    font-family: var(--font-body);
    font-size: var(--font-size-h5);
    line-height: 1.3;
  }

  .prose--article :global(blockquote strong) {
    font-weight: var(--font-weight-bold);
  }

  .prose--article :global(img),
  .prose--article :global(video) {
    border-radius: var(--radius-lg);
  }
</style>
