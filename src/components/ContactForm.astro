---
import { FORMSPREE_FORM_ID, FORMSPREE_TEST_FORM_ID } from 'astro:env/server';

interface Props {
  /** `full` is the Contact page form; `short` is the name/email/message form used elsewhere on the live site. */
  variant?: 'full' | 'short';
  /** Prefix for element ids, so two forms can share a page. */
  idPrefix?: string;
}

const { variant = 'full', idPrefix = 'contact' } = Astro.props;

// Production posts to the live form. Previews and local builds use the test
// form when one is configured, so testing never lands in the real inbox.
const isProduction = process.env.VERCEL_ENV === 'production';
const formId = isProduction ? FORMSPREE_FORM_ID : (FORMSPREE_TEST_FORM_ID ?? FORMSPREE_FORM_ID);
if (!formId) {
  if (isProduction) throw new Error('FORMSPREE_FORM_ID is not set for the production build.');
  console.warn('[ContactForm] No Formspree form ID set; the form will not submit.');
}

const id = (name: string) => `${idPrefix}-${name}`;
---

<div class="contact-form">
  <form
    action={`https://formspree.io/f/${formId ?? 'not-configured'}`}
    method="POST"
    data-contact-form
    aria-describedby={id('error')}
  >
    <input type="hidden" name="form" value={variant === 'full' ? 'Contact page' : 'Short form'} />

    <!-- Labels are visually hidden to match the live design, which shows placeholders only. -->
    <div class="contact-form__field">
      <label class="visually-hidden" for={id('name')}>Name</label>
      <input type="text" id={id('name')} name="name" placeholder="Name" autocomplete="name" required />
    </div>

    {
      variant === 'full' && (
        <div class="contact-form__field">
          <label class="visually-hidden" for={id('company')}>Company</label>
          <input type="text" id={id('company')} name="company" placeholder="Company" autocomplete="organization" />
        </div>
      )
    }

    <div class="contact-form__field">
      <label class="visually-hidden" for={id('email')}>Email</label>
      <input
        type="email"
        id={id('email')}
        name="email"
        placeholder="Email"
        autocomplete="email"
        spellcheck="false"
        required
      />
    </div>

    {
      variant === 'full' && (
        <div class="contact-form__field">
          <label class="visually-hidden" for={id('website')}>Website</label>
          <input type="url" id={id('website')} name="website" placeholder="Website" autocomplete="url" />
        </div>
      )
    }

    <div class="contact-form__field">
      <label class="visually-hidden" for={id('message')}>Message</label>
      <textarea
        id={id('message')}
        name="message"
        rows="5"
        placeholder="What goals do you need your brand to achieve?"
        required></textarea>
    </div>

    <!-- Honeypot: hidden from people, filled in by bots. Formspree drops submissions that include it. -->
    <div class="contact-form__trap" aria-hidden="true">
      <label class="visually-hidden" for={id('gotcha')}>Leave this field empty</label>
      <input type="text" id={id('gotcha')} name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <p class="contact-form__error" id={id('error')} role="alert" hidden></p>

    <button type="submit" class="contact-form__submit">Submit</button>
  </form>

  <p class="contact-form__success" role="status" tabindex="-1" hidden>
    Thanks for reaching out. Your message is on its way, and we'll be in touch soon.
  </p>
</div>

<script>
  // Without JavaScript the form posts straight to Formspree, which shows its
  // own thank-you page. With it, submit in the background and confirm inline.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-contact-form]')) {
    const wrapper = form.closest('.contact-form')!;
    const success = wrapper.querySelector<HTMLElement>('.contact-form__success')!;
    const error = form.querySelector<HTMLElement>('.contact-form__error')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const showError = (message: string) => {
      error.textContent = message;
      error.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      for (const field of form.querySelectorAll('[aria-invalid]')) field.removeAttribute('aria-invalid');

      button.disabled = true;
      button.textContent = 'Sending...';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        // Formspree returns { errors: [{ field?, message }] } for rejected submissions.
        const data = await response.json().catch(() => ({}));
        const errors: { field?: string; message: string }[] = data.errors ?? [];
        for (const { field } of errors) {
          if (field) form.querySelector(`[name="${CSS.escape(field)}"]`)?.setAttribute('aria-invalid', 'true');
        }
        showError(
          errors.map((e) => e.message).join(' ') ||
            'Something went wrong sending your message. Please try again.',
        );
      } catch {
        showError('Your message could not be sent. Check your connection and try again.');
      } finally {
        button.disabled = false;
        button.textContent = 'Submit';
      }
    });
  }
</script>

<style>
  .contact-form form {
    display: grid;
    gap: var(--space-sm);
  }

  .contact-form__field {
    display: grid;
    gap: var(--space-3xs);
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--color-text-muted);
  }

  .contact-form [aria-invalid='true'] {
    border-color: var(--color-orchid);
  }

  .contact-form__trap {
    position: absolute;
    left: -10000px;
  }

  .contact-form__submit {
    justify-self: start;
    padding: var(--space-xs) var(--space-lg);
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-cyan);
    color: var(--color-black);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .contact-form__submit:hover {
    background-color: var(--color-mint);
  }

  .contact-form__submit:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .contact-form__error {
    margin: 0;
    color: var(--color-orchid);
  }

  .contact-form__success {
    margin: 0;
    font-size: var(--font-size-lg);
  }
</style>
