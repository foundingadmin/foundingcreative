---
import { FORMSPREE_FORM_ID, FORMSPREE_TEST_FORM_ID } from 'astro:env/server';

interface Props {
  /**
   * `full` is the Contact page form; `short` is the name/email/message form
   * used elsewhere on the live site; `sitelaunch` is the inquiry form on the
   * SiteLaunch package pages (adds package and timeline).
   */
  variant?: 'full' | 'short' | 'sitelaunch';
  /** For `sitelaunch`: the package to preselect. */
  sitelaunchPackage?: 'Prism' | 'Rocket' | 'Orbit';
  /** Prefix for element ids, so two forms can share a page. */
  idPrefix?: string;
}

const { variant = 'full', idPrefix = 'contact', sitelaunchPackage } = Astro.props;
const detailed = variant !== 'short';
const formName = { full: 'Contact page', short: 'Short form', sitelaunch: `SiteLaunch: ${sitelaunchPackage ?? 'Not sure'}` }[variant];
const packages = ['Prism', 'Rocket', 'Orbit'];
const timelines = ['As soon as possible', 'In 1 to 3 months', 'In 3 to 6 months', 'Just exploring'];

// Production posts to the live form. Previews and local builds use the test
// form when one is configured, so testing never lands in the real inbox.
const isProduction = process.env.VERCEL_ENV === 'production';
const formId = isProduction ? FORMSPREE_FORM_ID : (FORMSPREE_TEST_FORM_ID ?? FORMSPREE_FORM_ID);
if (!formId) {
  if (isProduction) throw new Error('FORMSPREE_FORM_ID is not set for the production build.');
  console.warn('[ContactForm] No Formspree form ID set; the form will not submit.');
}

const id = (name: string) => `${idPrefix}-${name}`;
---

<div class="contact-form">
  <form
    action={`https://formspree.io/f/${formId ?? 'not-configured'}`}
    method="POST"
    data-contact-form
    aria-describedby={id('error')}
  >
    <input type="hidden" name="form" value={formName} />
    {
      variant === 'sitelaunch' && (
        <input type="hidden" name="_subject" value={`New ${sitelaunchPackage ?? ''} SiteLaunch inquiry`.replace('  ', ' ')} />
      )
    }

    <!-- Labels are visually hidden to match the live design, which shows placeholders only. -->
    <div class="contact-form__field">
      <label class="visually-hidden" for={id('name')}>Name</label>
      <input type="text" id={id('name')} name="name" placeholder="Name" autocomplete="name" required />
    </div>

    {
      detailed && (
        <div class="contact-form__field">
          <label class="visually-hidden" for={id('company')}>Company</label>
          <input type="text" id={id('company')} name="company" placeholder="Company" autocomplete="organization" />
        </div>
      )
    }

    <div class="contact-form__field">
      <label class="visually-hidden" for={id('email')}>Email</label>
      <input
        type="email"
        id={id('email')}
        name="email"
        placeholder="Email"
        autocomplete="email"
        spellcheck="false"
        required
      />
    </div>

    {
      detailed && (
        <div class="contact-form__field">
          <label class="visually-hidden" for={id('website')}>Website</label>
          <input type="url" id={id('website')} name="website" placeholder="Website" autocomplete="url" />
        </div>
      )
    }

    {
      variant === 'sitelaunch' && (
        <div class="contact-form__row">
          <div class="contact-form__field">
            <label for={id('package')}>SiteLaunch package</label>
            <select id={id('package')} name="sitelaunch_package">
              {packages.map((name) => (
                <option value={name} selected={name === sitelaunchPackage}>
                  {name} SiteLaunch
                </option>
              ))}
              <option value="Not sure yet" selected={!sitelaunchPackage}>
                Not sure yet
              </option>
            </select>
          </div>
          <div class="contact-form__field">
            <label for={id('timeline')}>Ideal launch timeline</label>
            <select id={id('timeline')} name="timeline">
              {timelines.map((timeline) => (
                <option value={timeline}>{timeline}</option>
              ))}
            </select>
          </div>
        </div>
      )
    }

    <div class="contact-form__field">
      <label class="visually-hidden" for={id('message')}>Message</label>
      <textarea
        id={id('message')}
        name="message"
        rows="5"
        placeholder={variant === 'sitelaunch' ? 'What goals do you need your website to achieve?' : 'What goals do you need your brand to achieve?'}
        required></textarea>
    </div>

    <!-- Optional and unchecked by default, so consent is opt-in. Unchecked boxes are not sent. -->
    <div class="contact-form__optin">
      <input
        type="checkbox"
        id={id('optin')}
        name="marketing_opt_in"
        value="Yes"
        aria-describedby={id('optin-note')}
      />
      <label for={id('optin')}>Send me occasional emails with Founding Creative news and insights.</label>
      <p class="contact-form__note" id={id('optin-note')}>
        Unsubscribe anytime. See our <a href="/privacy-statement-us/">Privacy Statement</a>.
      </p>
    </div>

    <!-- Honeypot: hidden from people, filled in by bots. Formspree drops submissions that include it. -->
    <div class="contact-form__trap" aria-hidden="true">
      <label class="visually-hidden" for={id('gotcha')}>Leave this field empty</label>
      <input type="text" id={id('gotcha')} name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <p class="contact-form__error" id={id('error')} role="alert" hidden></p>

    <button type="submit" class="contact-form__submit">Submit</button>
  </form>

  <p class="contact-form__success" role="status" tabindex="-1" hidden>
    <strong>Thanks, we got your message.</strong> Someone from our team will get back to you soon.
  </p>
</div>

<script>
  // Without JavaScript the form posts straight to Formspree, which shows its
  // own thank-you page. With it, submit in the background and confirm inline.
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-contact-form]')) {
    const wrapper = form.closest('.contact-form')!;
    const success = wrapper.querySelector<HTMLElement>('.contact-form__success')!;
    const error = form.querySelector<HTMLElement>('.contact-form__error')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;

    const showError = (message: string) => {
      error.textContent = message;
      error.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      error.hidden = true;
      for (const field of form.querySelectorAll('[aria-invalid]')) field.removeAttribute('aria-invalid');

      button.disabled = true;
      button.textContent = 'Sending...';
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (response.ok) {
          form.hidden = true;
          success.hidden = false;
          success.focus();
          return;
        }
        // Formspree returns { errors: [{ field?, message }] } for rejected submissions.
        const data = await response.json().catch(() => ({}));
        const errors: { field?: string; message: string }[] = data.errors ?? [];
        for (const { field } of errors) {
          if (field) form.querySelector(`[name="${CSS.escape(field)}"]`)?.setAttribute('aria-invalid', 'true');
        }
        showError(
          errors.map((e) => e.message).join(' ') ||
            'Something went wrong sending your message. Please try again.',
        );
      } catch {
        showError('Your message could not be sent. Check your connection and try again.');
      } finally {
        button.disabled = false;
        button.textContent = 'Submit';
      }
    });
  }
</script>

<style>
  .contact-form form {
    display: grid;
    gap: var(--space-sm);
  }

  .contact-form__field {
    display: grid;
    gap: var(--space-3xs);
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: var(--space-sm);
  }

  .contact-form__field label:not(.visually-hidden) {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .contact-form input,
  .contact-form textarea,
  .contact-form select {
    width: 100%;
    padding: var(--space-xs) var(--space-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: var(--color-text-muted);
  }

  .contact-form [aria-invalid='true'] {
    border-color: var(--color-orchid);
  }

  .contact-form__optin {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-3xs) var(--space-xs);
    align-items: start;
  }

  .contact-form__optin input {
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.2em;
    padding: 0;
    accent-color: var(--color-cyan);
  }

  .contact-form__note {
    grid-column: 2;
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  .contact-form__trap {
    position: absolute;
    left: -10000px;
  }

  .contact-form__submit {
    justify-self: start;
    padding: var(--space-xs) var(--space-lg);
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-cyan);
    color: var(--color-black);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }

  .contact-form__submit:hover {
    background-color: var(--color-mint);
  }

  .contact-form__submit:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .contact-form__error {
    margin: 0;
    color: var(--color-orchid);
  }

  .contact-form__success {
    margin: 0;
    font-size: var(--font-size-lg);
  }
</style>
