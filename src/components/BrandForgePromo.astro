---
import Icon from './Icon.astro';

// A short pitch for BrandForge, the fixed-scope brand package for startups,
// shown on the branding services page and the services overview. The link
// goes to the full BrandForge page.
---

<section class="forge-promo container section" aria-labelledby="forge-promo-heading">
  <div class="forge-promo__card" data-reveal>
    <div>
      <p class="forge-promo__label">New for startups</p>
      <h2 id="forge-promo-heading">BrandForge: a launch-ready brand in weeks</h2>
      <p class="forge-promo__text">
        Launching a company or a product and need to look ready from day one? BrandForge is our fixed-scope package for
        startups: research-backed strategy, a complete visual identity, and a brand system your team and your AI tools
        can both use, in weeks instead of months.
      </p>
    </div>
    <a class="button button--primary" href="/brandforge/">
      See how BrandForge works <Icon name="arrow-up-right" size={16} />
    </a>
  </div>
</section>

<style>
  /* The same teal card as the BrandForge feature in the Services menu */
  .forge-promo__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-xl);
    padding: var(--space-xl);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--color-forge-teal), var(--color-night));
    color: var(--color-text);
  }

  .forge-promo__label {
    margin: 0 0 var(--space-xs);
    color: var(--color-forge-cyan);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .forge-promo h2 {
    font-size: var(--font-size-h4);
  }

  .forge-promo__text {
    max-width: 44rem;
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 977px) {
    .forge-promo__card {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-lg);
      padding: var(--space-lg);
    }
  }
</style>
