---
import Icon from './Icon.astro';
import logo from '../assets/brand/founding-wordmark-white.svg';
import { mainNav, sitelaunch, letsTalkHref, bookMeetingHref } from '../data/navigation';

const current = Astro.url.pathname;
const isCurrent = (href: string) => (current === href ? 'page' : undefined);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/">
      <img src={logo.src} width="135" height="45" alt="Founding Creative home" />
    </a>

    <nav class="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li class="site-nav__item site-nav__item--parent" data-disclosure="dropdown">
                <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href)}>
                  {item.label}
                </a>
                <button type="button" class="site-nav__toggle" aria-expanded="false" aria-controls="services-menu">
                  <span class="visually-hidden">{item.label} menu</span>
                  <Icon name="chevron-down" size={16} />
                </button>
                <div class="site-nav__menu" id="services-menu">
                  <div class="site-nav__menu-clip">
                    <div class="container site-nav__menu-inner">
                      <div class="mega-col">
                        <p class="mega-col__label">Services</p>
                        <ul>
                          {item.children.map((child, i) => (
                            <li style={`--i: ${i}`}>
                              <a href={child.href} aria-current={isCurrent(child.href)}>
                                {child.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="mega-col">
                        <p class="mega-col__label">SiteLaunch websites</p>
                        <ul>
                          {sitelaunch.map((link, i) => (
                            <li style={`--i: ${i + 2}`}>
                              <a href={link.href} aria-current={isCurrent(link.href)}>
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <a class="mega-feature" href="/brandforge/" style="--i: 4">
                        <span class="mega-feature__label">New for startups</span>
                        <span class="mega-feature__title">BrandForge</span>
                        <span class="mega-feature__text">Brand strategy and identity, launch-ready in weeks.</span>
                      </a>
                    </div>
                  </div>
                </div>
              </li>
            ) : (
              <li class="site-nav__item">
                <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href)}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <a class="site-header__cta" href={letsTalkHref}>Let's talk<span class="visually-hidden">, book a call</span></a>

    <a class="site-header__book" href={bookMeetingHref}>Book a Meeting</a>
    <button type="button" class="site-header__menu-button" aria-haspopup="dialog" aria-controls="mobile-menu">
      <Icon name="menu" size={28} />
      <span class="visually-hidden">Menu</span>
    </button>
  </div>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Menu">
    <button type="button" class="mobile-menu__close" data-close>
      <Icon name="x" size={24} />
      <span class="visually-hidden">Close menu</span>
    </button>
    <nav aria-label="Main">
      <ul class="mobile-menu__list">
        {
          mainNav.map((item) =>
            item.children ? (
              <li data-disclosure="accordion">
                <button
                  type="button"
                  class="mobile-menu__item mobile-menu__toggle"
                  aria-expanded="false"
                  aria-controls="mobile-services-menu"
                >
                  {item.label}
                  <Icon name="chevron-down" size={16} />
                </button>
                <ul class="mobile-menu__sublist" id="mobile-services-menu" hidden>
                  {item.children.map((child) => (
                    <li>
                      <a class="mobile-menu__item" href={child.href} aria-current={isCurrent(child.href)}>
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
              <li>
                <a class="mobile-menu__item" href={item.href} aria-current={isCurrent(item.href)}>
                  {item.label}
                </a>
              </li>
            ),
          )
        }
        <li>
          <a class="mobile-menu__item mobile-menu__cta" href={letsTalkHref}>Let's talk<span class="visually-hidden">, book a call</span></a>
        </li>
      </ul>
    </nav>
  </dialog>
</header>

<script>
  // Services dropdown (and the mobile Services accordion): a disclosure
  // button that opens on click, Enter, or Space. On desktop "Services" itself
  // is a link to /services/ (so crawlers reach every service page from the
  // nav), the chevron beside it is the button, and hovering either opens the
  // menu for mouse users.
  for (const item of document.querySelectorAll<HTMLElement>('[data-disclosure]')) {
    const button = item.querySelector<HTMLButtonElement>('button[aria-controls]')!;
    const panel = document.getElementById(button.getAttribute('aria-controls')!)!;

    // Opened by hovering: a click pins it open instead of toggling it shut,
    // and only a hover-opened menu closes when the pointer leaves.
    let openedByHover = false;
    // The desktop dropdown animates open in CSS (keyed off aria-expanded) and
    // is kept out of reach with `inert` while closed; the mobile accordion
    // just shows and hides.
    const isDropdown = item.dataset.disclosure === 'dropdown';
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      if (isDropdown) panel.inert = !open;
      else panel.hidden = !open;
      if (!open) openedByHover = false;
    };
    if (isDropdown) panel.inert = true;

    button.addEventListener('click', () => {
      if (openedByHover) openedByHover = false;
      else setOpen(button.getAttribute('aria-expanded') !== 'true');
    });
    // The desktop dropdown floats over the page, so Escape, a click outside,
    // or focus leaving it closes it. The mobile accordion stays open until
    // toggled, and Escape there closes the whole menu.
    if (item.dataset.disclosure === 'dropdown') {
      item.addEventListener('pointerenter', (event) => {
        if (event.pointerType !== 'mouse' || button.getAttribute('aria-expanded') === 'true') return;
        openedByHover = true;
        setOpen(true);
      });
      item.addEventListener('pointerleave', (event) => {
        if (event.pointerType === 'mouse' && openedByHover) setOpen(false);
      });
      item.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
      item.addEventListener('focusout', (event) => {
        if (!item.contains(event.relatedTarget as Node | null)) setOpen(false);
      });
      document.addEventListener('click', (event) => {
        if (!item.contains(event.target as Node)) setOpen(false);
      });
    }
  }

  // Mobile menu: a modal <dialog>, which traps focus and closes on Escape.
  const dialog = document.querySelector<HTMLDialogElement>('#mobile-menu')!;
  const opener = document.querySelector<HTMLButtonElement>('.site-header__menu-button')!;
  opener.addEventListener('click', () => dialog.showModal());
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  // Close on a click outside the panel (on the backdrop). Clicks on the
  // panel's own empty space also target the dialog, so check the position.
  dialog.addEventListener('click', (event) => {
    const box = dialog.getBoundingClientRect();
    const outside =
      event.clientX < box.left || event.clientX > box.right || event.clientY < box.top || event.clientY > box.bottom;
    if (event.target === dialog && outside) dialog.close();
  });
  dialog.addEventListener('close', () => opener.focus());
</script>

<style>
  /* Clear and lightly frosted at the top of the page, so the hero gradient
   * shows through as on the live site; a deeper frosted bar once the page
   * scrolls ([data-scrolled] is set by src/scripts/motion.ts). Heroes that
   * run under it add .under-header (global.css). */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    background-color: transparent;
    -webkit-backdrop-filter: blur(5px);
    backdrop-filter: blur(5px);
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast);
  }

  .site-header[data-scrolled] {
    border-bottom-color: var(--color-border);
    background-color: rgb(0 4 7 / 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: var(--header-height);
  }

  .site-header__logo {
    margin-right: auto;
  }

  .site-header__logo img {
    width: 135px;
    height: auto;
  }

  /* Desktop nav */
  .site-nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__item {
    position: relative;
  }

  /* "Services" link and its chevron button sit side by side */
  .site-nav__item--parent {
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
  }

  .site-nav__link,
  .site-nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3xs);
    padding: var(--space-2xs) 0;
    border: 0;
    background: none;
    color: var(--color-text);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-regular);
    text-decoration: none;
    cursor: pointer;
  }

  .site-nav__link:hover,
  .site-nav__toggle:hover,
  .site-nav__link[aria-current='page'] {
    color: var(--color-mint);
  }

  .site-nav__toggle .icon {
    transition: transform var(--transition-fast);
  }

  .site-nav__toggle[aria-expanded='true'] .icon {
    transform: rotate(180deg);
  }

  /* Services: a full-width panel that grows open under the header, after
   * Apple's product nav (skiper75). The header is its containing block. */
  .site-nav__item--parent {
    position: static;
  }

  .site-nav__menu {
    position: absolute;
    top: 100%;
    right: 0;
    left: 0;
    display: grid;
    grid-template-rows: 0fr;
    border-bottom: 1px solid transparent;
    background-color: rgb(0 4 7 / 0.97);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 450ms var(--ease-out),
      opacity 300ms var(--ease-out),
      visibility 0s linear 450ms;
  }

  .site-nav__toggle[aria-expanded='true'] + .site-nav__menu {
    grid-template-rows: 1fr;
    border-bottom-color: var(--color-border);
    opacity: 1;
    visibility: visible;
    transition:
      grid-template-rows 450ms var(--ease-out),
      opacity 300ms var(--ease-out),
      visibility 0s;
  }

  /* The menu hangs from the header's bottom edge, a gap below "Services".
   * This invisible strip fills the gap, so the pointer stays inside the item
   * on its way down and a hover-opened menu doesn't close under it. */
  .site-nav__menu::before {
    content: '';
    position: absolute;
    bottom: 100%;
    right: 0;
    left: 0;
    height: 1.25rem;
  }

  .site-nav__menu-clip {
    overflow: hidden;
  }

  .site-nav__menu-inner {
    display: grid;
    grid-template-columns: 1fr 1fr minmax(16rem, 1.2fr);
    gap: var(--space-xl);
    padding-block: var(--space-lg) var(--space-xl);
  }

  .mega-col__label,
  .mega-feature__label {
    margin: 0 0 var(--space-sm);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .mega-col ul {
    display: grid;
    gap: var(--space-3xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega-col a {
    display: inline-block;
    padding-block: var(--space-3xs);
    color: var(--color-text);
    font-size: var(--font-size-lg);
    text-decoration: none;
  }

  .mega-col a:hover,
  .mega-col a[aria-current='page'] {
    color: var(--color-mint);
  }

  .mega-feature {
    display: grid;
    align-content: end;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--color-forge-teal), var(--color-night));
    color: var(--color-text);
    text-decoration: none;
  }

  .mega-feature__title {
    font-family: var(--font-display);
    font-size: var(--font-size-h4);
  }

  .mega-feature__text {
    color: var(--color-text-muted);
  }

  .mega-feature:hover {
    border-color: var(--color-forge-cyan);
  }

  /* Links settle in one after another as the panel opens */
  .mega-col li,
  .mega-feature {
    opacity: 0;
    transform: translateY(-0.5rem);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
  }

  .site-nav__toggle[aria-expanded='true'] + .site-nav__menu :is(.mega-col li, .mega-feature) {
    opacity: 1;
    transform: none;
    transition-delay: calc(120ms + var(--i, 0) * 35ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__menu,
    .site-nav__toggle[aria-expanded='true'] + .site-nav__menu,
    .mega-col li,
    .mega-feature {
      transition: none;
    }
  }

  .site-header__cta {
    padding: var(--space-2xs) var(--space-lg);
    border: 1px solid var(--color-white);
    border-radius: var(--radius-pill);
    color: var(--color-white);
    font-size: var(--font-size-lg);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .site-header__cta:hover {
    background-color: var(--color-mint);
    border-color: var(--color-mint);
    color: var(--color-black);
  }

  /* Mobile header: Book a Meeting plus the menu button */
  .site-header__book,
  .site-header__menu-button {
    display: none;
  }

  .site-header__book {
    color: var(--color-cyan);
    font-size: var(--font-size-sm);
    text-decoration: none;
  }

  .site-header__menu-button {
    padding: var(--space-2xs);
    border: 0;
    background: none;
    color: var(--color-white);
    cursor: pointer;
  }

  @media (max-width: 977px) {
    .site-nav,
    .site-header__cta {
      display: none;
    }

    .site-header__book,
    .site-header__menu-button {
      display: inline-flex;
    }
  }

  /* Mobile menu panel, light like the live site */
  .mobile-menu {
    width: min(100%, 26rem);
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0 0 0 auto;
    padding: var(--space-xl) var(--space-md) var(--space-md);
    border: 0;
    background-color: var(--color-white);
    color: var(--color-black);
  }

  .mobile-menu::backdrop {
    background-color: rgb(0 0 0 / 0.6);
  }

  .mobile-menu__close {
    position: absolute;
    top: var(--space-sm);
    right: var(--space-sm);
    padding: var(--space-2xs);
    border: 0;
    background: none;
    color: var(--color-black);
    cursor: pointer;
  }

  .mobile-menu__list,
  .mobile-menu__sublist {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mobile-menu__sublist {
    margin-top: var(--space-2xs);
    padding-left: var(--space-sm);
  }

  .mobile-menu__item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: var(--space-sm) var(--space-md);
    border: 0;
    border-radius: var(--radius-xs);
    background-color: var(--color-neutral-lightest);
    color: var(--color-black);
    font-size: var(--font-size-sm);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  .mobile-menu__item:hover,
  .mobile-menu__item[aria-current='page'] {
    background-color: var(--color-neutral-lighter);
    color: var(--color-black);
  }

  .mobile-menu__toggle[aria-expanded='true'] .icon {
    transform: rotate(180deg);
  }

  .mobile-menu__cta {
    justify-content: center;
    margin-top: var(--space-sm);
    background-color: var(--color-mint);
    font-weight: var(--font-weight-semibold);
  }

  .mobile-menu__cta:hover {
    background-color: var(--color-mint-dark);
  }

  .mobile-menu :focus-visible {
    outline-color: var(--color-black);
  }
</style>
