---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

// An image slideshow modeled on dd.nyc's service pages: each new image wipes
// in over the last one (a clip-path reveal, left to right going forward and
// right to left going back) while it settles from a slight zoom. Under the
// frame, a row of hairlines marks the slides and the current one fills as it
// plays, next to a 01 / 03 counter and arrows.
//
// It advances on its own every few seconds, pauses while hovered or focused,
// and has a pause button (WCAG 2.2.2). Reduced-motion visitors get no
// autoplay and no wipe. Without JavaScript the first image simply shows.

interface Props {
  /** Unique on the page. */
  id: string;
  /** Accessible name, like "Design Services examples". */
  label: string;
  images: { src: ImageMetadata; alt: string }[];
  /** Milliseconds each image stays up. */
  interval?: number;
  class?: string;
}

const { id, label, images, interval = 5000, class: className } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div
  class:list={['wipe', className]}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-wipe
  data-interval={interval}
  style={`--wipe-interval: ${interval}ms`}
>
  <div class="wipe__frame">
    <div class="wipe__slides" id={id} aria-live="off">
      {
        images.map((image, i) => (
          <div
            class:list={['wipe__slide', { 'is-active': i === 0 }]}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${images.length}`}
            aria-hidden={i === 0 ? undefined : 'true'}
          >
            <Image
              src={image.src}
              alt={image.alt}
              widths={[560, 1120]}
              sizes="(max-width: 977px) 92vw, 560px"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </div>
        ))
      }
    </div>
  </div>

  {
    images.length > 1 && (
      <div class="wipe__bar" data-wipe-controls hidden>
        <button class="wipe__toggle" type="button" aria-pressed="false" data-wipe-toggle>
          <Icon name="pause" size={12} class="wipe__pause" />
          <Icon name="play" size={12} class="wipe__play" />
          <span class="visually-hidden">Pause slideshow</span>
        </button>
        <ol class="wipe__lines">
          {images.map((_, i) => (
            <li>
              <button type="button" aria-controls={id} aria-current={i === 0 ? 'true' : undefined} data-wipe-go={i}>
                <span class="visually-hidden">Show image {i + 1}</span>
              </button>
            </li>
          ))}
        </ol>
        <p class="wipe__count" aria-hidden="true">
          <span data-wipe-current>01</span> / {pad(images.length)}
        </p>
        <div class="wipe__arrows">
          <button class="wipe__arrow" type="button" aria-controls={id} data-wipe-step="-1">
            <Icon name="chevron-left" size={16} />
            <span class="visually-hidden">Previous image</span>
          </button>
          <button class="wipe__arrow" type="button" aria-controls={id} data-wipe-step="1">
            <Icon name="chevron-right" size={16} />
            <span class="visually-hidden">Next image</span>
          </button>
        </div>
      </div>
    )
  }
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-wipe]')) {
    const slides = [...root.querySelectorAll<HTMLElement>('.wipe__slide')];
    const controls = root.querySelector<HTMLElement>('[data-wipe-controls]');
    if (slides.length < 2 || !controls) continue;

    const lines = [...root.querySelectorAll<HTMLButtonElement>('[data-wipe-go]')];
    const counter = root.querySelector<HTMLElement>('[data-wipe-current]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-wipe-toggle]')!;
    const interval = Number(root.dataset.interval) || 5000;
    controls.hidden = false;

    let current = 0;
    let timer = 0;
    let paused = false; // by the visitor's button
    let held = false; // by hover or focus
    let visible = false;

    const show = (next: number, direction: 1 | -1) => {
      next = (next + slides.length) % slides.length;
      if (next === current) return;
      const from = slides[current];
      const to = slides[next];
      for (const slide of slides) slide.classList.remove('is-leaving', 'is-back');
      // The outgoing image stays underneath until the new one has wiped over it.
      from.classList.remove('is-active');
      from.classList.add('is-leaving');
      from.setAttribute('aria-hidden', 'true');
      to.classList.toggle('is-back', direction < 0);
      to.classList.add('is-active');
      to.removeAttribute('aria-hidden');
      lines[current].removeAttribute('aria-current');
      lines[next].setAttribute('aria-current', 'true');
      counter.textContent = String(next + 1).padStart(2, '0');
      current = next;
      restart();
    };

    // The active hairline fills over the interval; restarting the timer also
    // restarts that fill.
    const running = () => !paused && !held && visible && !reduceMotion.matches;
    const restart = () => {
      window.clearTimeout(timer);
      root.classList.remove('is-playing');
      void root.offsetWidth;
      if (!running()) return;
      root.classList.add('is-playing');
      timer = window.setTimeout(() => show(current + 1, 1), interval);
    };

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-wipe-step]')) {
      const step = Number(button.dataset.wipeStep) as 1 | -1;
      button.addEventListener('click', () => show(current + step, step));
    }
    lines.forEach((line, i) => line.addEventListener('click', () => show(i, i > current ? 1 : -1)));

    toggle.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      restart();
    });

    // Hold while the visitor is looking closely, or while it's off screen.
    root.addEventListener('pointerenter', () => ((held = true), restart()));
    root.addEventListener('pointerleave', () => ((held = false), restart()));
    root.addEventListener('focusin', () => ((held = true), restart()));
    root.addEventListener('focusout', (event) => {
      if (root.contains(event.relatedTarget as Node)) return;
      held = false;
      restart();
    });
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      restart();
    }).observe(root);
    reduceMotion.addEventListener('change', restart);
  }
</script>

<style>
  .wipe {
    --wipe-ease: cubic-bezier(0.77, 0, 0.18, 1);
  }

  /* The live site's hero frame: a 2px white rule around the image */
  .wipe__frame {
    overflow: hidden;
    border: 2px solid var(--color-white);
    border-radius: var(--radius-lg);
    background-color: var(--color-ink);
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 0.45);
  }

  .wipe__slides {
    display: grid;
  }

  /* Every slide sits in the same grid cell, clipped away until it's shown. */
  .wipe__slide {
    grid-area: 1 / 1;
    clip-path: inset(0 100% 0 0);
  }

  .wipe__slide.is-active,
  .wipe__slide.is-leaving {
    clip-path: inset(0);
  }

  .wipe__slide.is-active {
    z-index: 2;
  }

  .wipe__slide.is-leaving {
    z-index: 1;
  }

  .wipe__slide img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .wipe__bar {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }

  .wipe__bar[hidden] {
    display: none;
  }

  /* Hairlines, one per slide: the current one thickens and fills */
  .wipe__lines {
    display: flex;
    flex: 1;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wipe__lines li {
    flex: 1;
  }

  .wipe__lines button {
    position: relative;
    display: block;
    width: 100%;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .wipe__lines button::before,
  .wipe__lines button::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1px;
    background-color: rgb(255 255 255 / 0.3);
    transition: background-color var(--transition-fast);
  }

  .wipe__lines button:hover::before {
    background-color: rgb(255 255 255 / 0.7);
  }

  .wipe__lines button::after {
    height: 3px;
    margin-top: -1px;
    background-image: var(--holo-gradient);
    box-shadow: var(--text-glow);
    transform: scaleX(0);
    transform-origin: left;
  }

  .wipe__lines [aria-current='true']::after {
    transform: scaleX(1);
  }

  .wipe__count {
    margin: 0;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    letter-spacing: 0.1em;
    font-variant-numeric: tabular-nums;
  }

  .wipe__count span {
    color: var(--color-white);
  }

  .wipe__arrows {
    display: flex;
    gap: var(--space-3xs);
  }

  .wipe__arrow,
  .wipe__toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-stroke);
    border-radius: var(--radius-pill);
    background-color: var(--color-glass);
    color: var(--color-white);
    cursor: pointer;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .wipe__arrow:hover,
  .wipe__toggle:hover {
    border-color: var(--color-white);
    box-shadow: var(--glow-white);
  }

  .wipe__toggle {
    width: 1.75rem;
    height: 1.75rem;
  }

  .wipe__toggle[aria-pressed='true'] :global(.wipe__pause),
  .wipe__toggle[aria-pressed='false'] :global(.wipe__play) {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wipe__slide.is-active {
      animation: wipe-in 1.1s var(--wipe-ease) both;
    }

    .wipe__slide.is-active.is-back {
      animation-name: wipe-in-back;
    }

    .wipe__slide.is-active img {
      animation: wipe-settle 1.8s var(--ease-out) both;
    }

    /* The first image is already in place when the page loads */
    .wipe__slide.is-active:first-child:not(.is-back) {
      animation-duration: 0s;
    }

    .wipe__slide.is-active:first-child:not(.is-back) img {
      animation: none;
    }

    .wipe__lines button::after {
      transition: transform 400ms var(--ease-out);
    }

    /* While playing, the current line fills over the whole interval */
    .wipe.is-playing .wipe__lines [aria-current='true']::after {
      animation: wipe-progress var(--wipe-interval) linear both;
    }
  }

  @keyframes wipe-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  @keyframes wipe-in-back {
    from {
      clip-path: inset(0 0 0 100%);
    }
  }

  @keyframes wipe-settle {
    from {
      transform: scale(1.12);
    }
  }

  @keyframes wipe-progress {
    from {
      transform: scaleX(0);
    }
  }
</style>
