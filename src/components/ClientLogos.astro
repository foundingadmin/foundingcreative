---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import honeywell from '../assets/home/clients/honeywell-logo.png';
import gsk from '../assets/home/clients/gsk-logo.png';
import maryKay from '../assets/home/clients/mary-kay-logo-solid.png';
import mastercard from '../assets/home/clients/mastercard-logo.png';
import tata from '../assets/home/clients/tat-horizontal.png';
import volvo from '../assets/home/clients/volvo-logo-solid.png';
import wrigley from '../assets/home/clients/wrigley-logo-solid.png';
import zurich from '../assets/home/clients/zurich-logo.png';
import infosys from '../assets/home/clients/infosys-logo.png';
import nissan from '../assets/home/clients/nissan-logo-solid.png';
import zippo from '../assets/home/clients/zippo-logo.png';
import bankOfAmerica from '../assets/home/clients/bank-of-america-logo.png';

// Brands Founding Creative has worked with, in an endless scrolling row like
// the live site's logo marquee. The row is drawn twice so it loops without a
// gap; the copy is hidden from screen readers. A button pauses it (WCAG 2.2.2),
// it pauses on hover, and it sits still for reduced-motion visitors.
const clients = [
  { src: honeywell, name: 'Honeywell' },
  { src: gsk, name: 'GSK' },
  { src: maryKay, name: 'Mary Kay' },
  { src: mastercard, name: 'Mastercard' },
  { src: tata, name: 'Tata' },
  { src: volvo, name: 'Volvo' },
  { src: wrigley, name: 'Wrigley' },
  { src: zurich, name: 'Zurich' },
  { src: infosys, name: 'Infosys' },
  { src: nissan, name: 'Nissan' },
  { src: zippo, name: 'Zippo' },
  { src: bankOfAmerica, name: 'Bank of America' },
];
---

<div class="clients" data-marquee>
  <div class="clients__viewport">
    <div class="clients__track">
      {
        [false, true].map((copy) => (
          <ul class="clients__list" aria-label={copy ? undefined : "Brands we've worked with"} aria-hidden={copy ? 'true' : undefined}>
            {clients.map((client) => (
              <li>
                <Image src={client.src} alt={copy ? '' : `${client.name} logo`} height={48} />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
  <button class="clients__toggle" type="button" aria-pressed="false" data-marquee-toggle>
    <Icon name="pause" size={14} class="clients__pause" />
    <Icon name="play" size={14} class="clients__play" />
    <span class="visually-hidden">Pause logo animation</span>
  </button>
</div>

<script>
  for (const marquee of document.querySelectorAll<HTMLElement>('[data-marquee]')) {
    const toggle = marquee.querySelector<HTMLButtonElement>('[data-marquee-toggle]')!;
    toggle.addEventListener('click', () => {
      const paused = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(paused));
      marquee.toggleAttribute('data-paused', paused);
    });
  }
</script>

<style>
  .clients {
    position: relative;
    margin: 0 0 var(--space-xl);
  }

  .clients__viewport {
    overflow: hidden;
    /* Logos fade in and out at the edges */
    mask-image: linear-gradient(90deg, transparent, var(--color-black) 12%, var(--color-black) 88%, transparent);
  }

  .clients__track {
    display: flex;
    width: max-content;
    animation: marquee 40s linear infinite;
  }

  .clients:hover .clients__track,
  .clients:focus-within .clients__track,
  .clients[data-paused] .clients__track {
    animation-play-state: paused;
  }

  .clients__list {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
    margin: 0;
    padding: 0 var(--space-2xl) 0 0;
    list-style: none;
  }

  .clients img {
    width: auto;
    height: 2rem;
    max-width: 7.5rem;
    object-fit: contain;
    filter: brightness(1.7);
  }

  .clients__toggle {
    position: absolute;
    right: 0;
    bottom: calc(-1 * var(--space-lg));
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background-color: var(--color-surface);
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .clients__toggle:hover {
    color: var(--color-text);
  }

  .clients__toggle[aria-pressed='true'] :global(.clients__pause),
  .clients__toggle[aria-pressed='false'] :global(.clients__play) {
    display: none;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  /* Reduced motion: a still, wrapped row of logos and no toggle */
  @media (prefers-reduced-motion: reduce) {
    .clients__viewport {
      mask-image: none;
    }

    .clients__track {
      width: auto;
      animation: none;
    }

    .clients__list {
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-lg) var(--space-xl);
      padding: 0;
    }

    .clients__list[aria-hidden='true'],
    .clients__toggle {
      display: none;
    }
  }
</style>
