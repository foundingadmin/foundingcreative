---
import { Image } from 'astro:assets';
import { formatDate, isoDate, postUrl, type Post } from '../lib/content';

// A Field Notes card for the white index page, as on the live site: the cover
// over a light offset "stack", a Gelica title, then the date and categories.
// The whole card is one link, through the title.

interface Props {
  post: Post;
  /** Heading level for the card title, so it fits the page outline. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="post-card">
  <div class="post-card__media">
    <Image
      src={post.data.cover}
      alt={post.data.coverAlt}
      widths={[480, 960, 1200]}
      sizes="(max-width: 700px) 92vw, 560px"
    />
  </div>
  <Heading class="post-card__title">
    <a href={postUrl(post)}>{post.data.title}</a>
  </Heading>
  <p class="post-card__meta">
    <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    <span aria-hidden="true">/</span>
    <span class="post-card__categories">{post.data.categories.join(', ')}</span>
  </p>
</article>

<style>
  .post-card {
    position: relative;
    color: var(--color-night);
  }

  /* The cover sits on a light offset card, and slides off it on hover */
  .post-card__media {
    position: relative;
    margin: 0.75rem 0.75rem 0 0;
  }

  .post-card__media::before {
    content: '';
    position: absolute;
    inset: -0.75rem -0.75rem 0.75rem 0.75rem;
    background-color: var(--color-neutral-lightest);
    transition: background-color var(--transition-fast);
  }

  .post-card__media img {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background-color: var(--color-aurora-plum);
    transition: transform 600ms var(--ease-out);
  }

  .post-card:hover .post-card__media img {
    transform: translate(-0.375rem, 0.375rem);
  }

  .post-card:hover .post-card__media::before {
    background-color: var(--color-cyan);
  }

  .post-card__title {
    max-width: 14em;
    margin: var(--space-md) 0 var(--space-xs);
    font-size: var(--font-size-h5);
    font-weight: var(--font-weight-medium);
    line-height: var(--line-height-snug);
    text-wrap: balance;
  }

  .post-card__title a {
    color: inherit;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    transition: background-size 500ms var(--ease-out);
  }

  .post-card:hover .post-card__title a {
    background-size: 100% 1px;
  }

  /* The whole card is clickable through the title link. */
  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card:has(a:focus-visible) {
    outline: var(--focus-ring-width) solid var(--color-night);
    outline-offset: var(--focus-ring-offset);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: 0;
    color: var(--color-neutral-dark);
    font-size: var(--font-size-sm);
  }

  .post-card__categories {
    color: var(--color-rocket);
    font-weight: var(--font-weight-semibold);
  }
</style>
