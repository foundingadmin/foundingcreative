---
import { Image } from 'astro:assets';
import { formatDate, isoDate, postUrl, type Post } from '../lib/content';

interface Props {
  post: Post;
  /** Heading level for the card title, so it fits the page outline. */
  headingLevel?: 2 | 3;
}

const { post, headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
---

<article class="post-card">
  <Image
    class="post-card__image"
    src={post.data.cover}
    alt={post.data.coverAlt}
    widths={[400, 800]}
    sizes="(max-width: 700px) 100vw, 400px"
  />
  <div class="post-card__body">
    <p class="post-card__meta">
      <span>{post.data.categories.join(', ')}</span>
      <time datetime={isoDate(post.data.date)}>{formatDate(post.data.date)}</time>
    </p>
    <Heading class="post-card__title">
      <a href={postUrl(post)}>{post.data.title}</a>
    </Heading>
    <p class="post-card__excerpt">{post.data.excerpt}</p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    transition: border-color var(--transition-fast);
  }

  .post-card:hover,
  .post-card:focus-within {
    border-color: var(--color-mint);
  }

  .post-card__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .post-card__body {
    display: grid;
    gap: var(--space-xs);
    padding: var(--space-md);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs);
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .post-card__title {
    margin: 0;
    font-size: var(--font-size-h6);
  }

  /* The whole card is clickable through the title link. */
  .post-card__title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .post-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card__title a:focus-visible {
    outline: none;
  }

  .post-card:has(a:focus-visible) {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .post-card__excerpt {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
