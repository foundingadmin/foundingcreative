---
import Icon from './Icon.astro';
import { letsTalkHref } from '../data/navigation';

// Closing call to action on the holographic background.
interface Props {
  heading: string;
  text?: string;
  eyebrow?: string;
  /** Primary button; defaults to "Let's talk". */
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const {
  heading,
  text,
  eyebrow,
  primary = { label: "Let's talk", href: letsTalkHref },
  secondary = { label: 'Send us a message', href: '/contact-us/' },
} = Astro.props;
const id = `cta-${heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<section class="cta holo-bg" aria-labelledby={id}>
  <div class="container cta__content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 id={id}>{heading}</h2>
    {text && <p class="section__lead">{text}</p>}
    <slot />
    <div class="cta__actions">
      <a class="button button--primary" href={primary.href}>
        {primary.label}
        <Icon name="arrow-up-right" size={16} />
      </a>
      <a class="button" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-3xl);
    text-align: center;
  }

  .cta__content {
    position: relative;
  }

  .cta h2 {
    max-width: 22ch;
    margin-inline: auto;
  }

  .cta .section__lead {
    max-width: 44rem;
    margin-inline: auto;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }
</style>
