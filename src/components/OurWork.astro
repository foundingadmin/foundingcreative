---
import Carousel from './Carousel.astro';
import CaseStudyCard from './CaseStudyCard.astro';
import Icon from './Icon.astro';
import { getCaseStudies } from '../lib/content';

// "Our work": case studies in a slider, as on the live site. The homepage and
// the end of each case study (leaving out the one being read) list them all;
// service pages pick their own few and their own heading.

interface Props {
  /** Case study id to leave out. */
  exclude?: string;
  /** Only these case studies, in this order. */
  only?: string[];
  heading?: string;
  intro?: string;
}

const {
  exclude,
  only,
  heading = 'Creative foundations worth showing off',
  intro = 'A look inside the projects where strategy, structure, and design all came together to drive meaningful business outcomes.',
} = Astro.props;
const all = await getCaseStudies();
const studies = only
  ? only.map((id) => all.find((study) => study.id === id)).filter((study) => study !== undefined)
  : all.filter((study) => study.id !== exclude);
---

<section class="container section our-work" aria-labelledby="work-heading">
  <div class="section__intro section__intro--split">
    <div>
      <p class="eyebrow">Our <em>work</em></p>
      <h2 id="work-heading">{heading}</h2>
      <p class="section__lead">{intro}</p>
    </div>
    <a class="button" href="/case-studies/">All case studies <Icon name="arrow-up-right" size={16} /></a>
  </div>
  <Carousel id="work-slider" label="Case studies" controls="sides" bleed class="our-work__slider">
    {
      studies.map((study) => (
        <li>
          <CaseStudyCard study={study} headingLevel={3} />
        </li>
      ))
    }
  </Carousel>
</section>

<style>
  /* The class lands on the Carousel's root, outside this component's scope */
  :global(.our-work__slider) {
    --slide-width: 21.75rem;
    --slide-gap: var(--space-md);
  }

  /* Room for the card hover lift and glow inside the scrolling row */
  :global(.our-work__slider .carousel__track) {
    padding-block: var(--space-sm) var(--space-lg);
  }

  /* The row fades to the page black at the window's right edge, so the next
   * arrow sits on dark ground over any cover. Gone once the row reaches its
   * end, so the last card shows in full. */
  :global(.our-work__slider)::after {
    content: '';
    position: absolute;
    inset-block: 0;
    right: calc(50% - 50vw);
    width: calc(50vw - 50% + var(--fade-width, 10rem));
    background: linear-gradient(to right, transparent, var(--color-bg) var(--fade-width, 10rem));
    pointer-events: none;
    transition: opacity var(--transition-fast);
  }

  :global(.our-work__slider:has(.carousel__button--next:disabled))::after {
    opacity: 0;
  }

  :global(.our-work__slider .carousel__controls) {
    z-index: 1;
  }

  @media (max-width: 977px) {
    :global(.our-work__slider) {
      --fade-width: 4rem;
    }

    /* The buttons sit under the slides here, clear of the fade */
    :global(.our-work__slider)::after {
      bottom: calc(2.5rem + var(--space-sm));
    }
  }
</style>
