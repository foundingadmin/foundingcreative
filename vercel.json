{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/coffee",
      "destination": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ1I3oI4KqMnFfcTTL5qkzXIuY06h4DeAE4B10vNbRNinT71if9o6Tj8-BXP-0kzp8vnu2KKz7yb",
      "permanent": false
    },
    {
      "source": "/coffee/",
      "destination": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ1I3oI4KqMnFfcTTL5qkzXIuY06h4DeAE4B10vNbRNinT71if9o6Tj8-BXP-0kzp8vnu2KKz7yb",
      "permanent": false
    },
    {
      "source": "/testimonial/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/tag/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/author/(.*)",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/blog/page/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/case-studies/(_.*)",
      "destination": "/case-studies/",
      "permanent": true
    },
    {
      "source": "/comments/feed/",
      "destination": "/feed/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/feed.xml"
    },
    {
      "source": "/feed/",
      "destination": "/feed.xml"
    }
  ]
}
