{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/coffee",
      "destination": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ1I3oI4KqMnFfcTTL5qkzXIuY06h4DeAE4B10vNbRNinT71if9o6Tj8-BXP-0kzp8vnu2KKz7yb",
      "permanent": false
    },
    {
      "source": "/coffee/",
      "destination": "https://calendar.google.com/calendar/appointments/schedules/AcZssZ1I3oI4KqMnFfcTTL5qkzXIuY06h4DeAE4B10vNbRNinT71if9o6Tj8-BXP-0kzp8vnu2KKz7yb",
      "permanent": false
    },
    {
      "source": "/client-portal/",
      "destination": "/buckit/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/aprilaire/",
      "destination": "/case-study/aprilaire-product-app/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/atl-freight-website/",
      "destination": "/case-study/atlfreight-website/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/banking-app/",
      "destination": "/case-study/bank-apps/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/bell-bird-atm(-old)?/",
      "destination": "/case-study/bell-bird-atm/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/genpact-grow-event(-2)?/",
      "destination": "/case-study/genpact-grow-event/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/hucklerberry-holler-website/",
      "destination": "/case-study/plant-nursery-ecommerce/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/interactive-mural/",
      "destination": "/case-study/interactive-learning-mural/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/mastercard-innovation-forum(.*)",
      "destination": "/case-study/innovation-forum-event/",
      "permanent": true
    },
    {
      "source": "/case-studies(-old)?/safezone/",
      "destination": "/case-study/safezone-product-and-branding/",
      "permanent": true
    },
    {
      "source": "/case-study/bell-bird-atm-2/",
      "destination": "/case-study/bell-bird-atm/",
      "permanent": true
    },
    {
      "source": "/case-study/website/",
      "destination": "/case-study/turntide-website/",
      "permanent": true
    },
    {
      "source": "/case-studies-2/",
      "destination": "/case-studies/",
      "permanent": true
    },
    {
      "source": "/case-studies-old/",
      "destination": "/case-studies/",
      "permanent": true
    },
    {
      "source": "/case-studies-old/(.*)",
      "destination": "/case-studies/",
      "permanent": true
    },
    {
      "source": "/testimonial/(.*)",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/category/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/tag/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/author/(.*)",
      "destination": "/about-us/",
      "permanent": true
    },
    {
      "source": "/blog/page/(.*)",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/case-studies/(_.*)",
      "destination": "/case-studies/",
      "permanent": true
    },
    {
      "source": "/comments/feed/",
      "destination": "/feed/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/feed",
      "destination": "/feed.xml"
    },
    {
      "source": "/feed/",
      "destination": "/feed.xml"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://use.typekit.net https://p.typekit.net; font-src 'self' https://use.typekit.net; img-src 'self' data: https://p.typekit.net https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://formspree.io https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; media-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "foundingcreative.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
